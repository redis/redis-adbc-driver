+	defer rec.Release()
+	reader, err := array.NewRecordReader(rec.Schema(), []arrow.RecordBatch{rec})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Release()
+	input := &operationCountingInput{RecordReader: reader}
+	if err := st.BindStream(ctx, input); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := st.ExecuteUpdate(ctx); err != nil || n != 0 {
