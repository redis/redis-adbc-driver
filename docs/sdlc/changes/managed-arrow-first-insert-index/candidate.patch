+	if state == nil || state.insertIndex == "" {
+		return "", false
+	}
+	return state.insertIndex, !state.mutable && !state.deleted && state.insertIndex == meta.index() && reflect.DeepEqual(state.insertArgs, indexCreateArgs(meta))
