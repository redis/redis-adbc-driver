@@ -0,0 +1,400 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/apache/arrow-adbc/go/adbc"
+	"github.com/apache/arrow-go/v18/arrow"
+	"github.com/apache/arrow-go/v18/arrow/array"
+	"github.com/apache/arrow-go/v18/arrow/memory"
+	goredis "github.com/redis/go-redis/v9"
+)
+
+type snapshotArrowIndexObserver struct {
+	raw                                    goredis.UniversalClient
+	creates, early, batches, notifications int
+	loseRow, loseCreate                    bool
+	indexedFirst                           bool
+	cancel                                 context.CancelFunc
+	index                                  string
+	proof                                  *snapshotIndexNotifyObserver
+	scans                                  *snapshotFullIndexScanCounter
+}
+
+func (*snapshotArrowIndexObserver) DialHook(next goredis.DialHook) goredis.DialHook { return next }
+func (*snapshotArrowIndexObserver) ProcessPipelineHook(next goredis.ProcessPipelineHook) goredis.ProcessPipelineHook {
+	return next
+}
+func (o *snapshotArrowIndexObserver) ProcessHook(next goredis.ProcessHook) goredis.ProcessHook {
+	if o.proof != nil {
+		next = o.proof.ProcessHook(next)
+	}
+	if o.scans != nil {
+		next = o.scans.ProcessHook(next)
+	}
+	return func(ctx context.Context, cmd goredis.Cmder) error {
+		a := snapshotObservedControlArgs(cmd)
+		row := len(a) > 2 && snapshotObservedControlName(cmd) == "eval" && a[1] == snapshotWriteBatchLua
+		notify := len(a) > 2 && snapshotObservedControlName(cmd) == "eval" && a[1] == snapshotIndexNotifyLua
+		create := cmd.Name() == "ft.create"
+		if create {
+			o.creates++
+			o.index = fmt.Sprint(cmd.Args()[1])
+			if data, ok := ctx.Value(snapshotEmptyIndexKey{}).(string); ok {
+				o.early++
+				if n, err := o.raw.ZCard(ctx, snapshotMembers(data)).Result(); err != nil || n != 0 {
+					return fmt.Errorf("early index directory not empty: %d %v", n, err)
+				}
+			}
+		}
+		err := next(ctx, cmd)
+		if err != nil {
+			return err
+		}
+		if create && o.loseCreate {
+			cmd.SetErr(io.ErrUnexpectedEOF)
+			return io.ErrUnexpectedEOF
+		}
+		if notify {
+			o.notifications++
+		}
+		if row {
+			o.batches++
+			if o.batches == 1 {
+				o.indexedFirst = o.early == 1
+				if o.cancel != nil {
+					o.cancel()
+				}
+			}
+			if o.loseRow {
+				o.loseRow = false
+				cmd.SetErr(io.ErrUnexpectedEOF)
+				return io.ErrUnexpectedEOF
+			}
+		}
+		return nil
+	}
+}
+
+func TestSnapshotArrowFirstInsertIndex(t *testing.T) {
+	for _, lose := range []bool{false, true} {
+		t.Run(fmt.Sprint("lost_row_reply_", lose), func(t *testing.T) {
+			h, raw, _ := newSnapshotHarnessMode(t, false, false)
+			observer := &snapshotArrowIndexObserver{raw: raw, loseRow: lose}
+			ctx, _ := statisticsHookedTransport(t, h, observer)
+			rec := followupRecord(513)
+			defer rec.Release()
+			if err := followupIngest(ctx, h.conn, "arrow_first", adbc.OptionValueIngestModeCreate, rec); err != nil {
+				t.Fatal(err)
+			}
+			if observer.creates != 1 || observer.early != 1 || observer.batches != 3 || observer.notifications != 0 || !observer.indexedFirst {
+				t.Fatalf("unexpected index/insert lifecycle: %+v", observer)
+			}
+			got, err := followupFetch(ctx, h.conn, "SELECT * FROM arrow_first")
+			if err != nil {
+				t.Fatal(err)
+			}
+			followupValidate(t, got, 1, 513)
+		})
+	}
+}
+
+func TestSnapshotArrowEmptyStaysDeferred(t *testing.T) {
+	h, raw, _ := newSnapshotHarnessMode(t, false, false)
+	observer := &snapshotArrowIndexObserver{raw: raw}
+	ctx, _ := statisticsHookedTransport(t, h, observer)
+	rec := followupRecord(0)
+	defer rec.Release()
+	if err := followupIngest(ctx, h.conn, "arrow_empty", adbc.OptionValueIngestModeCreate, rec); err != nil {
+		t.Fatal(err)
+	}
+	if observer.creates != 1 || observer.early != 0 || observer.batches != 0 || observer.notifications != 0 {
+		t.Fatalf("empty input started an early index: %+v", observer)
+	}
+	h.expectRows("SELECT COUNT(*) FROM arrow_empty", "0")
+}
+
+func TestSnapshotArrowUnknownCreateDoesNotPublish(t *testing.T) {
+	h, raw, _ := newSnapshotHarnessMode(t, false, false)
+	h.exec("CREATE TABLE arrow_unknown(v INTEGER)")
+	h.exec("INSERT INTO arrow_unknown VALUES(7)")
+	before := raw.HGet(h.ctx, snapshotCatalogKey, "root").Val()
+	observer := &snapshotArrowIndexObserver{raw: raw, loseCreate: true}
+	ctx, impl := statisticsHookedTransport(t, h, observer)
+	rec := followupRecord(513)
+	defer rec.Release()
+	if err := followupIngest(ctx, h.conn, "arrow_unknown", adbc.OptionValueIngestModeReplace, rec); err == nil {
+		t.Fatal("unknown CREATE was accepted")
+	}
+	if observer.creates != 1 || observer.batches != 0 || raw.HGet(h.ctx, snapshotCatalogKey, "root").Val() != before {
+		t.Fatal("unknown CREATE was retried, consumed rows or published")
+	}
+	h.expectRows("SELECT v FROM arrow_unknown", "7")
+	impl.store.reapSnapshotBudget(h.ctx, 2*time.Second)
+	if err := raw.Do(h.ctx, "FT.INFO", observer.index).Err(); !isUnknownIndex(err) {
+		t.Fatal("uncertain CREATE left an uncollectible private index", err)
+	}
+}
+
+func TestSnapshotArrowIndexFallsBackAfterPrivateOverwrite(t *testing.T) {
+	h, raw, _ := newSnapshotHarnessMode(t, false, false)
+	h.exec("CREATE TABLE arrow_overwrite(v INTEGER)")
+	s := snapshotTestStore(t, raw)
+	ctx, pin, err := s.acquireSnapshot(h.ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pin.release()
+	wctx, id, err := s.beginSnapshotWrite(ctx, pin)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.abortSnapshot(pin, id)
+	if err := s.prepareSnapshotTable(wctx, "public", "arrow_overwrite"); err != nil {
+		t.Fatal(err)
+	}
+	m := snapshotTableTest(t, s, wctx, "arrow_overwrite")
+	if err := s.beginSnapshotArrowIndex(wctx, m); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.insertRows(wctx, m, [][]Value{{intValue(typeInt32, 7)}}); err != nil {
+		t.Fatal(err)
+	}
+	old := m.index()
+	snapshotExecuteTest(t, s, wctx, "UPDATE arrow_overwrite SET v=8")
+	if err := s.publishSnapshot(wctx, pin, id); err != nil {
+		t.Fatal(err)
+	}
+	if err := raw.Do(h.ctx, "FT.INFO", old).Err(); !isUnknownIndex(err) {
+		t.Fatal("invalidated early index was retained", err)
+	}
+	h.expectRows("SELECT v FROM arrow_overwrite", "8")
+}
+
+func TestSnapshotArrowEarlyIndexAbortsIncompleteInput(t *testing.T) {
+	for _, mode := range []string{"reader_error", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			h, raw, _ := newSnapshotHarnessMode(t, false, false)
+			h.exec("CREATE TABLE arrow_abort(v INTEGER)")
+			h.exec("INSERT INTO arrow_abort VALUES(7)")
