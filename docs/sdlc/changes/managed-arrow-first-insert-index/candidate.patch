+		return wrapRedis(err, "failed to index private Arrow inserts")
+	}
+	scope.mu.Lock()
+	state.insertIndex, state.insertArgs = meta.index(), args
+	scope.mu.Unlock()
+	return nil
+}
+
+func snapshotInsertIndex(ctx context.Context, meta *tableMeta) (created string, usable bool) {
+	scope := snapshotOf(ctx)
