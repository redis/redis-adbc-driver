+	eligible := state != nil && !state.mutable && !state.deleted && state.insertIndex == ""
+	scope.mu.Unlock()
+	if !eligible {
+		return nil
+	}
+	// The global CREATE is never replayed. Existing Search gates validate the
+	// registered owner and lease before and after it; this context also requires
+	// the directory to be empty at both gates. Only insert-mode row batches follow.
