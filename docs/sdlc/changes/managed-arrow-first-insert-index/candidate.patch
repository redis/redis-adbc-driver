+			observer := &snapshotArrowIndexObserver{raw: raw}
+			ctx, _ := statisticsHookedTransport(t, h, observer)
+			if mode == "cancel" {
+				var cancel context.CancelFunc
+				ctx, cancel = context.WithCancel(ctx)
+				defer cancel()
+				observer.cancel = cancel
+			}
+			st, err := h.conn.NewStatement(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer st.Close(h.ctx)
+			for key, value := range map[string]string{adbc.OptionKeyIngestTargetTable: "arrow_abort", adbc.OptionKeyIngestMode: adbc.OptionValueIngestModeReplace} {
+				if err := st.SetOption(ctx, key, value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			rec := followupRecord(513)
+			defer rec.Release()
+			reader, err := array.NewRecordReader(rec.Schema(), []arrow.RecordBatch{rec})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer reader.Release()
+			if err := st.BindStream(ctx, &unmanagedArrowReaderFailure{RecordReader: reader}); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := st.ExecuteUpdate(ctx); err == nil {
