+func (s *store) beginSnapshotArrowIndex(ctx context.Context, meta *tableMeta) error {
+	scope := snapshotOf(ctx)
+	if scope == nil || !scope.write || scope.operation || scope.maintenance || meta.Unmanaged || s.flexEnabled() ||
+		meta.SnapshotImportSource != "" || meta.SnapshotSourceKey || snapshotOperationRequestOf(ctx) != nil ||
