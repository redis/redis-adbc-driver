+	for key, value := range map[string]string{adbc.OptionKeyIngestTargetTable: "arrow_retained", adbc.OptionKeyIngestMode: adbc.OptionValueIngestModeCreate, OptionStringOperationAction: "prepare"} {
+		if err := st.SetOption(ctx, key, value); err != nil {
