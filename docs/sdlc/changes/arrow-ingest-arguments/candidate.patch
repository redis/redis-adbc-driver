+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"testing"
+)
+
+func BenchmarkIngestSingleRowArguments(b *testing.B) {
+	for _, columns := range []int{8, 105} {
+		for _, shape := range []string{"dense", "one_nonnull"} {
+			meta := &tableMeta{}
+			row := make([]Value, columns+1)
+			for c := range columns {
+				typ := typeInt64
+				if c%3 == 1 {
+					typ = typeString
+				}
+				meta.Columns = append(meta.Columns, columnMeta{Name: "c" + strconv.Itoa(c), Type: typ, Nullable: true})
+				if shape == "one_nonnull" && c != columns-1 {
+					row[c] = nullValue(typ)
+				} else if typ == typeString {
+					row[c] = stringValue("payload\x00é")
+				} else {
+					row[c] = intValue(typeInt64, 9007199254740993)
+				}
+			}
+			ki := columns
+			meta.Columns = append(meta.Columns, columnMeta{Name: keyField, Type: typeString})
+			row[ki] = stringValue("app:single")
+			for _, mode := range []string{"managed", "unmanaged"} {
+				for _, variant := range []string{"baseline", "candidate"} {
+					b.Run(fmt.Sprintf("columns_%d/%s/%s/%s", columns, shape, mode, variant), func(b *testing.B) {
+						var result []any
+						build := func() int {
+							var names []any
+							if mode == "managed" || variant == "candidate" {
+								bound := meta.Columns
+								if mode == "managed" {
+									bound = bound[:ki]
+								}
+								names = make([]any, len(bound))
+								for i, c := range bound {
+									names[i] = c.field()
+								}
+							}
+							if mode == "managed" {
+								if variant == "baseline" {
+									result = ingestBaselineSnapshotFields(meta, rowAlloc{}, row[:ki], names, 0, "123")
+								} else {
+									result = snapshotInsertFields(meta, rowAlloc{}, row[:ki], names, 0, "123")
+								}
+								return 0
+							}
+							if variant == "baseline" {
+								var size int
+								result, size = ingestBaselineUnmanagedArgs(meta, ki, row)
+								return size
+							}
+							result = unmanagedInsertArgs(meta, ki, row, names)
+							return unmanagedInsertCommandBytes(result)
+						}
+						validate := func() {
+							names := make([]any, len(meta.Columns))
+							for i, c := range meta.Columns {
+								names[i] = c.field()
+							}
+							var want []any
+							if mode == "managed" {
+								want = ingestBaselineSnapshotFields(meta, rowAlloc{}, row[:ki], names, 0, "123")
+							} else {
+								want, _ = ingestBaselineUnmanagedArgs(meta, ki, row)
+							}
+							if !reflect.DeepEqual(result, want) {
+								b.Fatal("single-row argument image changed")
+							}
+						}
+						build()
+						validate()
+						b.ReportAllocs()
+						b.ResetTimer()
+						for range b.N {
+							ingestArgumentBytes = build()
+						}
+						b.StopTimer()
+						validate()
+						ingestArgumentPage = [][]any{result}
+					})
+				}
+			}
+		}
+	}
+}
