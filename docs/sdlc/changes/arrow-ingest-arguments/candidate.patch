+
+func TestIngestArgumentsPreserveImages(t *testing.T) {
+	meta := &tableMeta{SnapshotSourceKey: true, Columns: []columnMeta{
+		{Name: "wide", Type: typeInt64}, {Name: "empty", Type: typeString},
+		{Name: "missing", Type: typeString}, {Name: "binary", Type: typeBinary},
+		{Name: "not_a_number", Type: typeFloat64}, {Name: "day", Type: typeDate},
+	}}
+	row := []Value{intValue(typeInt64, 9007199254740993), stringValue(""), nullValue(typeString),
+		binaryValue("a\x00é\r\n"), floatValue(typeFloat64, math.NaN()), intValue(typeDate, -1)}
+	fields := []any{"renamed_physical", "empty", "missing", "binary", "not_a_number", "day"}
+	a := rowAlloc{added: []any{"later", "default"}, sourceKeys: []Value{stringValue("app:\x00source")}}
+	want := []any{rowIDField, "9007199254740993", snapshotSourceKeyField, "app:\x00source",
+		"renamed_physical", "9007199254740993", "empty", "", "binary", "a\x00é\r\n",
+		"not_a_number", nanStored, "day", "-1", "later", "default"}
+	got := snapshotInsertFields(meta, a, row, fields, 0, "9007199254740993")
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("snapshot image\ngot %#v\nwant %#v", got, want)
+	}
+	// Retained arguments keep independent slots when inputs are reused. The
+	// ingestion decoder still owns all input string payloads before this stage.
+	row[0], fields[0], a.added[1], a.sourceKeys[0] = intValue(typeInt64, 1), "changed", "changed", stringValue("changed")
+	if !reflect.DeepEqual(got, want) {
+		t.Fatal("retained snapshot arguments changed with input slots")
+	}
+	a.sourceKeys[0] = nullValue(typeString)
+	got = snapshotInsertFields(meta, a, nil, nil, 0, "2")
+	if !reflect.DeepEqual(got, []any{rowIDField, "2", "later", "changed"}) {
+		t.Fatalf("NULL provenance/empty image changed: %#v", got)
+	}
+}
+
+func TestIngestUnmanagedArgumentsPreserveSourceEncoding(t *testing.T) {
+	meta := &tableMeta{Columns: []columnMeta{
+		{Name: "flag", Field: "physical_flag", Type: typeBool, Encoding: "text", TextFormat: "YES"},
+		{Name: "missing", Type: typeString}, {Name: keyField, Type: typeString},
+		{Name: "payload", Type: typeString}, {Name: "exact", Type: typeInt64},
+	}}
+	row := []Value{boolValue(true), nullValue(typeString), stringValue("app:\x00é"), stringValue(""), intValue(typeInt64, 9007199254740993)}
+	fields := []any{"physical_flag", "missing", keyField, "payload", "exact"}
+	want := []any{"EVAL", keyRowInsertLua, 1, "app:\x00é", "physical_flag", "YES", "payload", "", "exact", "9007199254740993"}
+	got := unmanagedInsertArgs(meta, 2, row, fields)
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("source arguments\ngot %#v\nwant %#v", got, want)
+	}
+	row[2], fields[0] = stringValue("changed"), "changed"
+	if !reflect.DeepEqual(got, want) {
+		t.Fatal("retained source arguments changed with input slots")
+	}
+}
+
+func TestIngestUnmanagedByteAccounting(t *testing.T) {
+	for _, command := range [][]any{
+		{"EVAL", keyRowInsertLua, 1, "app:\x00é", "field", "", "binary", "\x00\r\n"},
+		{"future controls", int64(-123), true, nil, []byte{0, 1, 255}},
+	} {
+		want := 32
+		for _, arg := range command {
+			want += len(fmt.Sprint(arg)) + 32
+		}
+		if got := unmanagedInsertCommandBytes(command); got != want {
+			t.Fatalf("command byte estimate %d, want established %d", got, want)
+		}
+	}
+}
+
+// These controls retain the exact argument assembly from baseline3213aa54.
+// They intentionally stay test-only, allowing the production builders to be
+// compared without modifying stored values, command count or native semantics.
+func ingestBaselineSnapshotFields(meta *tableMeta, a rowAlloc, row []Value, fieldNames []any, r int, id string) []any {
+	fields := []any{rowIDField, id}
+	if meta.SnapshotSourceKey && len(a.sourceKeys) > 0 && !a.sourceKeys[r].Null {
+		fields = append(fields, snapshotSourceKeyField, a.sourceKeys[r].S)
+	}
+	for i, value := range row {
+		if !value.Null {
+			fields = append(fields, fieldNames[i], encodeStored(value))
+		}
+	}
+	return append(fields, a.added...)
+}
+
+func ingestBaselineUnmanagedArgs(meta *tableMeta, ki int, row []Value) ([]any, int) {
+	command := []any{"EVAL", keyRowInsertLua, 1, row[ki].S}
+	for j, c := range meta.Columns {
+		if j != ki && !row[j].Null {
+			command = append(command, c.field(), c.encode(row[j], c.TextFormat))
+		}
+	}
+	size := 32
+	for _, arg := range command {
+		size += len(fmt.Sprint(arg)) + 32
+	}
+	return command, size
+}
+
+var ingestArgumentPage [][]any
+var ingestArgumentBytes int
+
+func BenchmarkIngestArgumentAssembly(b *testing.B) {
+	for _, columns := range []int{8, 105} {
+		for _, nullPercent := range []int{0, 50, 95} {
+			meta := &tableMeta{}
+			rows := make([][]Value, 256)
+			for c := range columns {
+				typ := typeInt64
+				if c%3 == 1 {
+					typ = typeString
+				}
+				meta.Columns = append(meta.Columns, columnMeta{Name: "c" + strconv.Itoa(c), Type: typ})
+			}
+			meta.Columns = append(meta.Columns, columnMeta{Name: keyField, Type: typeString})
+			ki := columns
+			for r := range rows {
+				rows[r] = make([]Value, columns+1)
+				for c := range columns {
+					if (c+r)%100 < nullPercent {
+						rows[r][c] = nullValue(meta.Columns[c].Type)
+					} else if meta.Columns[c].Type == typeString {
+						rows[r][c] = stringValue("payload\x00é:" + strconv.Itoa(r))
+					} else {
+						rows[r][c] = intValue(typeInt64, 9007199254740993+int64(r))
+					}
+				}
+				rows[r][ki] = stringValue("app:" + strconv.Itoa(r))
+			}
+			for _, mode := range []string{"managed", "unmanaged"} {
+				for _, variant := range []string{"baseline", "candidate"} {
+					b.Run(fmt.Sprintf("columns_%d/null_%d/%s/%s", columns, nullPercent, mode, variant), func(b *testing.B) {
+						page := make([][]any, len(rows))
+						build := func() int {
+							// Include per-conversion-slice field boxing in both paths.
+							var names []any
+							if mode == "managed" || variant == "candidate" {
+								columns := meta.Columns
+								if mode == "managed" {
+									columns = columns[:ki]
+								}
+								names = make([]any, len(columns))
+								for c, col := range columns {
+									names[c] = col.field()
+								}
+							}
+							bytes := 0
+							for r, row := range rows {
+								if mode == "managed" {
+									if variant == "baseline" {
+										page[r] = ingestBaselineSnapshotFields(meta, rowAlloc{}, row[:ki], names, r, "123")
+									} else {
+										page[r] = snapshotInsertFields(meta, rowAlloc{}, row[:ki], names, r, "123")
+									}
+								} else if variant == "baseline" {
+									var size int
+									page[r], size = ingestBaselineUnmanagedArgs(meta, ki, row)
+									bytes += size
+								} else {
+									page[r] = unmanagedInsertArgs(meta, ki, row, names)
+									bytes += unmanagedInsertCommandBytes(page[r])
+								}
+							}
+							return bytes
+						}
+						validate := func() {
+							names := make([]any, len(meta.Columns))
+							for i, c := range meta.Columns {
+								names[i] = c.field()
+							}
+							for r, row := range rows {
+								var want []any
+								if mode == "managed" {
+									want = ingestBaselineSnapshotFields(meta, rowAlloc{}, row[:ki], names, r, "123")
+								} else {
+									want, _ = ingestBaselineUnmanagedArgs(meta, ki, row)
+								}
+								if !reflect.DeepEqual(page[r], want) {
+									b.Fatal("argument image changed", r)
+								}
+							}
+						}
+						build()
+						validate()
+						b.ReportAllocs()
+						b.ResetTimer()
+						for range b.N {
+							ingestArgumentBytes = build()
+						}
+						b.StopTimer()
+						validate()
+						ingestArgumentPage = page
+					})
+				}
+			}
+		}
+	}
+}
