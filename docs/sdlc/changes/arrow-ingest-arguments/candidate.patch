+func unmanagedInsertArgs(meta *tableMeta, ki int, row []Value, fieldNames []any) []any {
+	fields := 0
+	for i, value := range row {
+		if i != ki && !value.Null {
+			fields++
+		}
+	}
+	command := make([]any, 4, 4+2*fields)
+	command[0], command[1], command[2], command[3] = "EVAL", keyRowInsertLua, 1, row[ki].S
+	for i, c := range meta.Columns {
+		if i != ki && !row[i].Null {
+			command = append(command, fieldNames[i], c.encode(row[i], c.TextFormat))
+		}
+	}
+	return command
+}
+
+func unmanagedInsertCommandBytes(command []any) int {
+	size := 32 // RESP array header and margin
+	for _, arg := range command {
+		if value, ok := arg.(string); ok {
+			size += len(value) + 32
+		} else {
+			// Preserve accounting for non-string control arguments and future
+			// callers; ordinary field names and encoded values need no formatter.
+			size += len(fmt.Sprint(arg)) + 32
+		}
+	}
+	return size
+}
