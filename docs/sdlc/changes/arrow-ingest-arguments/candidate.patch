+func snapshotInsertFields(meta *tableMeta, a rowAlloc, row []Value, fieldNames []any, r int, id string) []any {
+	count := 0
+	for _, value := range row {
+		if !value.Null {
+			count++
+		}
+	}
+	provenance := meta.SnapshotSourceKey && len(a.sourceKeys) > 0 && !a.sourceKeys[r].Null
+	capacity := 2 + 2*count + len(a.added)
+	if provenance {
+		capacity += 2
+	}
+	fields := make([]any, 2, capacity)
+	fields[0], fields[1] = rowIDField, id
+	if provenance {
+		fields = append(fields, snapshotSourceKeyField, a.sourceKeys[r].S)
+	}
+	for i, value := range row {
+		if !value.Null {
+			fields = append(fields, fieldNames[i], encodeStored(value))
+		}
+	}
+	return append(fields, a.added...)
+}
