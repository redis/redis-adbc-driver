+"""Selected unmanaged SQL/Arrow/raw cases using the established write harness."""
+import argparse
+from pathlib import Path
+
+from arrow_compare import Benchmark
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ('source', 'driver', 'cli', 'work'):
+        parser.add_argument('--' + name, type=Path, required=True)
+    parser.add_argument('--version', required=True)
+    parser.add_argument('--dedicated-empty-server', action='store_true', required=True)
+    parser.add_argument('--write-repeats', type=int, default=3)
+    parser.add_argument('--sql-batch-rows', type=int, default=1000)
+    parser.add_argument('--write-rows', type=int, default=10000)
+    args = parser.parse_args()
+    if args.write_repeats <= 0 or args.sql_batch_rows <= 0 or not 4 <= args.write_rows <= 100000 or args.write_rows % 4:
+        parser.error('Invalid row/repetition/batch count')
+    args.read_repeats = 0
+    benchmark = Benchmark(args)
+    benchmark.results['metadata']['scope'] = 'Unmanaged SQL/Arrow/raw string-sizing comparison'
+    benchmark.results['metadata']['write_paths'] = ['unmanaged_sql', 'unmanaged_arrow', 'redis_py']
+    cases = [(mode, api, writers, 'append') for writers in (1, 4)
+             for mode, api in (('unmanaged', 'sql'), ('unmanaged', 'arrow'), ('redis_py', 'hset'))]
+    try:
+        benchmark.write_cases('writes', cases)
+        benchmark.results['final_qpf'] = benchmark.gate()
+        benchmark.results['status'] = 'complete'
+        benchmark.save()
+    except Exception as error:
+        benchmark.results['status'] = 'failed'
+        benchmark.results['failures'].append({'error_type': type(error).__name__})
+        benchmark.save()
+        raise
+
+
+if __name__ == '__main__':
+    main()
