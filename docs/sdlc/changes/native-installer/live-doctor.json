{
  "distribution": "Redis Software",
  "redis_version": "8.6.2",
  "query_performance_factor": {
    "active": true,
    "scaling_factor": 4
  },
  "search_workers": 6,
  "sched_policy": "mnp",
  "conns": 32,
  "checks": [
    {
      "name": "verified Software TLS and both manifests",
      "exit_code": 0,
      "passed": true
    },
    {
      "name": "untrusted CA rejected",
      "exit_code": 1,
      "passed": true
    },
    {
      "name": "invalid authentication rejected",
      "exit_code": 1,
      "passed": true
    },
    {
      "name": "Search ACL denied",
      "exit_code": 1,
      "passed": true
    },
    {
      "name": "broken manifest rejected",
      "exit_code": 1,
      "passed": true
    },
    {
      "name": "missing native library rejected",
      "exit_code": 1,
      "passed": true
    },
    {
      "name": "server without Search rejected",
      "exit_code": 1,
      "passed": true
    }
  ]
}
