UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
	EXT := dylib
else ifeq ($(OS),Windows_NT)
	EXT := dll
else
	EXT := so
endif

VERSION ?= v0.1.0
# Generated by redis-up; explicit environment values still take precedence.
ifneq ($(wildcard build/test.env),)
REDIS_URI ?= $(shell . ./build/test.env; printf '%s' "$$REDIS_URI")
SSL_CERT_FILE ?= $(CURDIR)/build/test-tls/ca.pem
endif
export REDIS_URI SSL_CERT_FILE
LIB := build/libadbc_driver_redis.$(EXT)
CUDA_SOURCES := $(wildcard internal/cuda/*.go internal/cuda/*.c internal/cuda/*.h)
ADBC_CLI := build/redis-adbc
LDFLAGS := -s -w -X github.com/adbc-drivers/driverbase-go/driverbase.infoDriverVersion=$(VERSION)

.PHONY: check-test-env build adbc-cli test test-software validate acceptance clean redis-up redis-down redis-oss-up pgdiff pgdiff-test

build: $(LIB)

$(LIB): $(wildcard *.go internal/tlstrust/*.go) $(wildcard pkg/*.go) $(wildcard pkg/*.c) $(wildcard pkg/*.h) $(CUDA_SOURCES) go.mod go.sum
	mkdir -p build
	CGO_ENABLED=1 go build -buildmode=c-shared -tags driverlib -ldflags "$(LDFLAGS)" -o $@ ./pkg

# redis-adbc: check, copy and adopt HASH collections that the driver didn't
# write, and sweep the rows left under the key prefixes of dropped tables.
# It links the driver as a Go library, so it needs no cgo.
adbc-cli: $(ADBC_CLI)

$(ADBC_CLI): $(wildcard *.go internal/tlstrust/*.go) $(wildcard cmd/redis-adbc/*.go) $(CUDA_SOURCES) go.mod go.sum
	mkdir -p build
	CGO_ENABLED=0 go build -ldflags "$(LDFLAGS)" -o $@ ./cmd/redis-adbc

# One package at a time: with REDIS_URI set, the driver's and redis-adbc's
# integration tests share the server, and any connection that opens rolls
# back an abandoned move (adbc.redis.rename_rekey), including the ones the
# driver's tests set up and expect to find.
# Disable caching because the running integration server is external state.
test: check-test-env
	go test -count=1 -v -p 1 ./...

# The Software data proxy filters eviction-policy introspection. Verify the
# management API/QPF first, then carry only that owned endpoint's declaration.
test-software:
	bash software-setup.sh --exec go test -count=1 -v -p 1 $(TEST_ARGS) ./...

redis-up:
	bash software-setup.sh

redis-down:
	docker compose stop redis-software
	docker compose rm -f redis-software

redis-oss-up:
	docker compose --profile oss up --detach --wait redis

acceptance: build
	bash software-setup.sh --exec env REDIS_ADBC_LIBRARY="$(abspath $(LIB))" python3 "$(abspath ../python/scripts/run-acceptance.py)" $(ACCEPTANCE_SUITES) --results "$(abspath build/acceptance)"

validate: build check-test-env
	cd validation && uv run pytest -vvs -rfEsxX tests/

clean:
	rm -rf build

# Pinned amd64 Postgres reference; Redis must already be running.
pgdiff: build check-test-env
	uv run --project pgdiff python pgdiff/run.py $(PGDIFF_ARGS)

pgdiff-test:
	uv run --project pgdiff python -m unittest discover -s pgdiff -p "test_*.py"

# Make integration entry points fail if setup was omitted instead of skipping.
check-test-env:
	@test -n "$$REDIS_URI" || (echo 'Run make redis-up or export an authenticated TLS Enterprise REDIS_URI' >&2; exit 1)
