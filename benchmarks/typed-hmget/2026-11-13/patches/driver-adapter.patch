+// Experimental adapter for the unreleased owned nullable-string command.
+// Page discovery and bounds are identical to fetchHashPage. No interface values
+// or result buffers are reconstructed/reused between the parser and projection.
+func (it *scanIter) fetchTypedHashPage(ctx context.Context) hashPage {
+	if it.candidates != nil || it.delta != nil {
+		var logical, physical []string
+		var err error
+		if it.candidates != nil {
+			logical, physical, err = it.candidates.nextKeys(ctx)
+		} else {
+			logical, physical, err = it.delta.nextKeys(ctx)
+		}
+		if err != nil {
+			return hashPage{err: err}
+		}
+		fields := append(append([]string(nil), it.fetch...), snapshotDeletedField)
+		values, err := it.store.fetchTypedRowSlices(ctx, physical, fields, wideFetchChunk)
+		return hashPage{keys: logical, typedValues: values, err: err, snapshot: true}
+	}
+	if err := it.checkReadiness(ctx); err != nil {
+		return hashPage{err: err}
+	}
+	rows, err := it.cur.next(ctx)
+	if checked := it.checkReadiness(ctx); checked != nil {
+		return hashPage{err: checked}
+	}
+	if err != nil {
+		return hashPage{err: err}
+	}
+	keys := make([]string, len(rows))
+	for i, row := range rows {
+		if it.exists(row) {
+			keys[i] = row["__key"]
+		}
+	}
+	values, err := it.store.fetchTypedRowSlices(ctx, keys, it.fetch, wideFetchChunk)
+	return hashPage{keys: keys, typedValues: values, err: err}
+}
+
+func (s *store) fetchTypedRowSlices(ctx context.Context, keys, fields []string, chunk int) ([]goredis.NullableStringSlice, error) {
+	if err := cancelled(ctx); err != nil {
+		return nil, err
+	}
+	fields = append([]string{rowIDField}, fields...)
+	boxed := make([]any, len(fields))
+	for i, field := range fields {
+		boxed[i] = field
+	}
+	out := make([]goredis.NullableStringSlice, len(keys))
+	for start := 0; start < len(keys); start += chunk {
+		if err := cancelled(ctx); err != nil {
+			return nil, err
+		}
+		end := min(start+chunk, len(keys))
+		pipe := s.redis(ctx).Pipeline()
+		cmds := make([]*goredis.NullableStringSliceCmd, end-start)
+		for i, key := range keys[start:end] {
+			if key == "" {
+				continue
+			}
+			args := make([]any, 2+len(boxed))
+			args[0], args[1] = "hmget", key
+			copy(args[2:], boxed)
+			cmd := goredis.NewNullableStringSliceCmd(ctx, args...)
+			_ = pipe.Process(ctx, cmd)
+			cmds[i] = cmd
+		}
+		if _, err := pipe.Exec(ctx); err != nil && !errors.Is(err, goredis.Nil) {
+			return nil, wrapRedis(err, "failed to read rows")
+		}
+		for i, cmd := range cmds {
+			if cmd == nil {
+				continue
+			}
+			row, err := cmd.Result()
+			if err != nil {
+				return nil, wrapRedis(err, "failed to read rows")
+			}
+			if len(row.Values) != len(fields) || len(row.Valid) != len(fields) {
+				return nil, errorf(adbc.StatusInternal, "unexpected typed HMGET row width")
+			}
+			if !row.Valid[0] {
+				continue
+			}
+			out[start+i] = row
+		}
+	}
+	return out, nil
+}
+
+func (it *scanIter) consumeTypedHashValues(ctx context.Context, keys []string, rows []goredis.NullableStringSlice, snapshot bool) ([]string, []map[string]Value, error) {
+	defer clear(rows) // Only the driver-owned outer page, never a command result.
+	if it.diagnostics != nil {
+		it.diagnostics.processed.Add(int64(len(rows)))
+	}
+	kept := make([]string, 0, len(keys))
+	for i, row := range rows {
+		rows[i] = goredis.NullableStringSlice{}
+		if err := cancelled(ctx); err != nil {
+			return nil, nil, err
+		}
+		if snapshot {
+			if len(row.Values) == 0 || !row.Valid[0] || row.Values[0] != strings.TrimPrefix(keys[i], it.meta.prefix()) {
+				return nil, nil, errorf(adbc.StatusIO, "snapshot directory references a missing or invalid row")
+			}
+			last := len(row.Values) - 1
+			if row.Valid[last] && row.Values[last] == "1" {
+				continue
+			}
+			row = goredis.NullableStringSlice{Values: row.Values[:last], Valid: row.Valid[:last]}
+		} else if row.Values == nil {
+			continue
+		}
+		if err := it.projection.consumeTypedHash(row); err != nil {
+			return nil, nil, err
+		}
+		kept = append(kept, keys[i])
+	}
+	if it.diagnostics != nil {
+		it.diagnostics.matched.Add(int64(len(kept)))
+	}
+	return kept, nil, nil
+}
+
+func (p *scanProjection) decodeTypedHashInto(vals goredis.NullableStringSlice, row []Value) error {
+	if len(vals.Values) != len(p.hashFields)+1 || len(vals.Valid) != len(vals.Values) {
+		return errorf(adbc.StatusInternal, "unexpected typed HMGET row width")
+	}
+	id := nullValue(typeInt64)
+	if vals.Valid[0] {
+		var err error
+		id, err = decodeStored(vals.Values[0], typeInt64)
+		if err != nil {
+			return err
+		}
+	}
+	for _, output := range p.rowID {
+		row[output] = id
+	}
+	for i := range p.columns {
+		c := &p.columns[i]
+		var v Value
+		var err error
+		pos := p.hashPositions[i]
+		if vals.Valid[pos] {
+			v, err = c.decode(vals.Values[pos])
+		} else {
+			v = nullValue(c.column.Type)
+			if c.column.MissingThrough > 0 && !id.Null && !vals.Valid[p.hashNullPositions[i]] {
+				v, err = c.column.missingValueForID(id.I)
+			}
+		}
+		if err != nil {
+			return errorf(adbc.StatusInternal, "column %q: %v", c.column.Name, err)
+		}
+		for _, output := range c.outputs {
+			row[output] = v
+		}
+	}
+	return nil
+}
