+
+	"github.com/apache/arrow-adbc/go/adbc"
+	goredis "github.com/redis/go-redis/v9"
+)
+
+func typedTestRow(values []any) goredis.NullableStringSlice {
+	row := goredis.NullableStringSlice{Values: make([]string, len(values)), Valid: make([]bool, len(values))}
+	for i, value := range values {
+		if value != nil {
+			row.Values[i] = value.(string)
+			row.Valid[i] = true
+		}
+	}
+	return row
+}
+
+func TestTypedHMGetProjectionParity(t *testing.T) {
+	_, p := hashProjectionFixture()
+	for _, values := range [][]any{
+		{"1", "9007199254740993", "a\x00b", nil, nil, "1234567890123456"},
+		{"2", "-9223372036854775808", nil, nil, "1", nil},
+		{"10", "9223372036854775807", "", nil, "", nil},
+		{"11", "1", nil, nil, nil, nil},
+		{"12", "1", "x", "-4", nil, nil},
+		{nil, nil, nil, nil, nil, nil},
+		{"3", "bad", "x", nil, nil, nil},
+		{"bad", "1", nil, nil, nil, nil},
+		{"4", "1", nil, nil, nil, "bad"},
+	} {
+		got, want := make([]Value, p.width), make([]Value, p.width)
+		gotErr := p.decodeTypedHashInto(typedTestRow(values), got)
+		wantErr := p.decodeHashInto(values, want)
+		if fmt.Sprint(gotErr) != fmt.Sprint(wantErr) || !reflect.DeepEqual(got, want) {
+			t.Fatalf("typed decode parity: %v / %v", gotErr, wantErr)
+		}
+	}
+	for _, row := range []goredis.NullableStringSlice{{}, {Values: []string{"1"}, Valid: []bool{true}}, {Values: make([]string, 6), Valid: make([]bool, 5)}} {
+		if err := p.decodeTypedHashInto(row, make([]Value, p.width)); !isStatus(err, adbc.StatusInternal) {
+			t.Fatal("width/mask error", err)
+		}
+	}
+}
+
+func TestTypedHMGetOuterReleaseOwnership(t *testing.T) {
+	it, _ := hashProjectionFixture()
+	row := typedTestRow([]any{"1", "9007199254740993", "x", nil, nil, nil, "0"})
+	retained := row
+	rows := []goredis.NullableStringSlice{row}
+	it.projection = &scanProjection{consumeTypedHash: func(goredis.NullableStringSlice) error { return nil }}
+	if _, _, err := it.consumeTypedHashValues(context.Background(), []string{it.meta.prefix() + "1"}, rows, true); err != nil {
+		t.Fatal(err)
+	}
+	if rows[0].Values != nil || retained.Values[0] != "1" || !retained.Valid[0] {
+		t.Fatal("outer release mutated a retained command result")
+	}
+}
