--- /dev/null
+++ b/go/command_wait_profile_test.go
@@ -0,0 +1,229 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	goredis "github.com/redis/go-redis/v9"
+)
+
+// All IDs here are process-local ordinals, never addresses, file descriptors or
+// infrastructure identities. Counters wrap the TLS plaintext side, not packets.
+type commandWaitIO struct {
+	reads, writes, readBytes, writeBytes, readID atomic.Int64
+}
+type commandWaitSnapshot struct{ reads, writes, readBytes, writeBytes int64 }
+
+func (m *commandWaitIO) snapshot() commandWaitSnapshot {
+	return commandWaitSnapshot{m.reads.Load(), m.writes.Load(), m.readBytes.Load(), m.writeBytes.Load()}
+}
+
+type commandWaitConn struct {
+	net.Conn
+	io *commandWaitIO
+	id int64
+}
+
+func (c *commandWaitConn) NetConn() net.Conn { return c.Conn }
+func (c *commandWaitConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	c.io.reads.Add(1)
+	c.io.readBytes.Add(int64(n))
+	c.io.readID.Store(c.id)
+	return n, err
+}
+func (c *commandWaitConn) Write(b []byte) (int, error) {
+	n, err := c.Conn.Write(b)
+	c.io.writes.Add(1)
+	c.io.writeBytes.Add(int64(n))
+	return n, err
+}
+
+type commandWaitDial struct {
+	Ordinal      int64  `json:"ordinal"`
+	VerifiedTLS  bool   `json:"verified_tls"`
+	TLSVersion   uint16 `json:"tls_version"`
+	NoDelayKnown bool   `json:"tcp_nodelay_known"`
+	NoDelay      bool   `json:"tcp_nodelay"`
+}
+type commandWaitProfile struct {
+	mode          string
+	client, probe *goredis.Client
+	io, probeIO   *commandWaitIO
+	ids           atomic.Int64
+	mu            sync.Mutex
+	dials         []commandWaitDial
+}
+
+func commandWaitMode(mode string) (probe string, separate bool, err error) {
+	switch mode {
+	case "control":
+		return "", false, nil
+	case "pacing_20ms":
+		return "pacing", false, nil
+	case "same_ping":
+		return "ping", false, nil
+	case "separate_ping":
+		return "ping", true, nil
+	case "same_time":
+		return "time", false, nil
+	case "separate_time":
+		return "time", true, nil
+	default:
+		return "", false, fmt.Errorf("unknown command wait mode")
+	}
+}
+func (p *commandWaitProfile) newClient(t *testing.T, raw *goredis.Client, oldIO *compactionReleaseIO, io *commandWaitIO) *goredis.Client {
+	t.Helper()
+	options := *raw.Options()
+	if options.Protocol != 3 || options.TLSConfig == nil || options.TLSConfig.InsecureSkipVerify {
+		t.Fatal("command wait profile requires strict TLS and RESP3")
+	}
+	options.ContextTimeoutEnabled = true
+	dial := goredis.NewDialer(&options)
+	options.Dialer = func(ctx context.Context, network, address string) (net.Conn, error) {
+		conn, err := dial(ctx, network, address)
+		if err != nil {
+			return nil, err
+		}
+		tc, ok := conn.(*tls.Conn)
+		if !ok {
+			_ = conn.Close()
+			return nil, fmt.Errorf("command wait profile requires native TLS transport")
+		}
+		state := tc.ConnectionState()
+		if !state.HandshakeComplete || len(state.VerifiedChains) == 0 {
+			_ = conn.Close()
+			return nil, fmt.Errorf("command wait TLS verification incomplete")
+		}
+		ordinal := p.ids.Add(1)
+		// Portable net.Conn exposes no read-only TCP_NODELAY getter.
+		// Leave it explicitly unobserved rather than change socket settings.
+		known, noDelay := false, false
+		p.mu.Lock()
+		p.dials = append(p.dials, commandWaitDial{ordinal, true, state.Version, known, noDelay})
+		p.mu.Unlock()
+		wrapped := &commandWaitConn{Conn: conn, io: io, id: ordinal}
+		return &compactionReleaseConn{Conn: wrapped, io: oldIO}, nil
+	}
+	client := goredis.NewClient(&options)
+	client.AddHook(snapshotHook{})
+	t.Cleanup(func() { _ = client.Close() })
+	return client
+}
+func newCommandWaitProfile(t *testing.T, raw *goredis.Client, oldIO *compactionReleaseIO, mode string) (*goredis.Client, *commandWaitProfile) {
+	t.Helper()
+	_, separate, err := commandWaitMode(mode)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &commandWaitProfile{mode: mode, io: &commandWaitIO{}}
+	p.client = p.newClient(t, raw, oldIO, p.io)
+	p.probe, p.probeIO = p.client, p.io
+	if separate {
+		p.probeIO = &commandWaitIO{}
+		p.probe = p.newClient(t, raw, &compactionReleaseIO{}, p.probeIO)
+	}
+	if err := p.client.Ping(context.Background()).Err(); err != nil {
+		t.Fatal("release transport warmup failed")
+	}
+	if separate {
+		if err := p.probe.Ping(context.Background()).Err(); err != nil {
+			t.Fatal("probe transport warmup failed")
+		}
+	}
+	return p.client, p
+}
+func (p *commandWaitProfile) before(ctx context.Context) map[string]any {
+	command, _, _ := commandWaitMode(p.mode)
+	row := map[string]any{"mode": p.mode, "prelude_nanoseconds": int64(0)}
+	if command == "pacing" {
+		start := time.Now()
+		timer := time.NewTimer(20 * time.Millisecond)
+		defer timer.Stop()
+		success := false
+		select {
+		case <-ctx.Done():
+		case <-timer.C:
+			success = ctx.Err() == nil
+		}
+		elapsed := time.Since(start).Nanoseconds()
+		row["pacing_success"], row["pacing_nanoseconds"], row["prelude_nanoseconds"] = success, elapsed, elapsed
+		row["probe_reads"], row["probe_writes"] = int64(0), int64(0)
+		row["probe_read_bytes"], row["probe_write_bytes"] = int64(0), int64(0)
+		row["probe_connection"], row["connection_relation"] = int64(0), "not_applicable"
+		return row
+	}
+	if command == "" {
+		return row
+	}
+	if ctx.Err() != nil {
+		row["probe_success"] = false
+		return row
+	}
+	before := p.probeIO.snapshot()
+	// Bound observation independently. Its elapsed still consumes part of the
+	// already-created release deadline; that pacing effect is reported.
+	probeCtx, cancel := context.WithTimeout(context.Background(), 250*time.Millisecond)
+	defer cancel()
+	start := time.Now()
+	success := false
+	if command == "ping" {
+		reply, err := p.probe.Ping(probeCtx).Result()
+		success = err == nil && reply == "PONG"
+	} else {
+		reply, err := p.probe.Time(probeCtx).Result()
+		success = err == nil && !reply.IsZero()
+	}
+	elapsed := time.Since(start)
+	after := p.probeIO.snapshot()
+	row["probe_success"], row["probe_nanoseconds"], row["probe_connection"] = success, elapsed.Nanoseconds(), p.probeIO.readID.Load()
+	row["prelude_nanoseconds"] = elapsed.Nanoseconds()
+	row["probe_reads"], row["probe_writes"] = after.reads-before.reads, after.writes-before.writes
+	row["probe_read_bytes"], row["probe_write_bytes"] = after.readBytes-before.readBytes, after.writeBytes-before.writeBytes
+	return row
+}
+func (p *commandWaitProfile) after(row map[string]any, before commandWaitSnapshot) {
+	after := p.io.snapshot()
+	row["release_connection"] = p.io.readID.Load()
+	row["release_read_bytes"], row["release_write_bytes"] = after.readBytes-before.readBytes, after.writeBytes-before.writeBytes
+	_, separate, _ := commandWaitMode(p.mode)
+	valid := p.io.readID.Load() > 0
+	if p.mode == "pacing_20ms" {
+		valid = valid && row["pacing_success"] == true && row["probe_reads"] == int64(0) && row["probe_writes"] == int64(0) && row["probe_connection"] == int64(0)
+	} else if p.mode != "control" {
+		valid = valid && row["probe_success"] == true && row["probe_reads"] == int64(1) && row["probe_writes"] == int64(1) && (row["probe_connection"] == row["release_connection"]) != separate
+	}
+	row["command_wait_valid"] = valid
+}
+func (p *commandWaitProfile) finish(t *testing.T, rows []map[string]any) {
+	t.Helper()
+	p.mu.Lock()
+	dials := append([]commandWaitDial(nil), p.dials...)
+	p.mu.Unlock()
+	encoded, err := json.Marshal(map[string]any{"mode": p.mode, "connections": dials})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("command_wait_transport %s", encoded)
+	if len(rows) == 0 {
+		t.Fatal("command wait observer recorded no releases")
+	}
+	for _, row := range rows {
+		if row["command_wait_valid"] != true || row["success"] != true || row["reads"] != int64(1) || row["writes"] != int64(1) || row["pool_misses"] != uint32(0) || row["pool_timeouts"] != uint32(0) {
+			t.Fatal("command wait observation invalid after full result validation")
+		}
+	}
+}
+func commandWaitRequested() string { return os.Getenv("REDIS_SNAPSHOT_COMMAND_WAIT") }
