index 00000000..18b85f9d
--- /dev/null
+++ b/go/command_wait_unit_test.go
@@ -0,0 +1,137 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	goredis "github.com/redis/go-redis/v9"
+)
+
+type commandWaitFailHook struct{ calls int }
+
+func (*commandWaitFailHook) DialHook(next goredis.DialHook) goredis.DialHook { return next }
+func (*commandWaitFailHook) ProcessPipelineHook(next goredis.ProcessPipelineHook) goredis.ProcessPipelineHook {
+	return next
+}
+func (h *commandWaitFailHook) ProcessHook(goredis.ProcessHook) goredis.ProcessHook {
+	return func(context.Context, goredis.Cmder) error {
+		h.calls++
+		return errors.New("private-endpoint-and-credential")
+	}
+}
+
+type commandWaitMemoryConn struct{ net.Conn }
+
+func (*commandWaitMemoryConn) Read(b []byte) (int, error)  { return copy(b, "OK"), nil }
+func (*commandWaitMemoryConn) Write(b []byte) (int, error) { return len(b), nil }
+
+func TestCommandWaitIsolation(t *testing.T) {
+	t.Run("fixed modes", func(t *testing.T) {
+		for _, mode := range []string{"control", "same_ping", "separate_ping", "same_time", "separate_time", "pacing_20ms"} {
+			if _, _, err := commandWaitMode(mode); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, _, err := commandWaitMode("private-endpoint-and-credential"); err == nil || strings.Contains(err.Error(), "private-") {
+			t.Fatal("mode rejection leaked input")
+		}
+	})
+	t.Run("plaintext counters and connection identity", func(t *testing.T) {
+		inner := &commandWaitMemoryConn{}
+		io := &commandWaitIO{}
+		conn := &commandWaitConn{Conn: inner, io: io, id: 7}
+		before := io.snapshot()
+		buffer := make([]byte, 8)
+		if n, err := conn.Read(buffer); err != nil || n != 2 {
+			t.Fatal(n, err)
+		}
+		if n, err := conn.Write([]byte("abc")); err != nil || n != 3 {
+			t.Fatal(n, err)
+		}
+		after := io.snapshot()
+		if before != (commandWaitSnapshot{}) || after != (commandWaitSnapshot{1, 1, 2, 3}) || io.readID.Load() != 7 || conn.NetConn() != inner {
+			t.Fatal("incorrect connection/counter snapshot")
+		}
+	})
+	for _, tc := range []struct {
+		name, mode     string
+		probe, release int64
+		success, want  bool
+	}{
+		{"control", "control", 0, 1, false, true},
+		{"same", "same_ping", 1, 1, true, true},
+		{"wrong same", "same_time", 2, 1, true, false},
+		{"separate", "separate_time", 2, 1, true, true},
+		{"wrong separate", "separate_ping", 1, 1, true, false},
+		{"probe failure", "same_ping", 1, 1, false, false},
+		{"missing release", "control", 0, 0, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			io := &commandWaitIO{}
+			io.readID.Store(tc.release)
+			p := &commandWaitProfile{mode: tc.mode, io: io}
+			row := map[string]any{"probe_connection": tc.probe, "probe_success": tc.success, "probe_reads": int64(1), "probe_writes": int64(1)}
+			p.after(row, commandWaitSnapshot{})
+			if row["command_wait_valid"] != tc.want {
+				t.Fatal("incorrect physical connection classification")
+			}
+		})
+	}
+	t.Run("canceled pacing is zero IO", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		p := &commandWaitProfile{mode: "pacing_20ms", io: &commandWaitIO{}}
+		row := p.before(ctx)
+		p.io.readID.Store(1)
+		p.after(row, commandWaitSnapshot{})
+		if row["pacing_success"] != false || row["command_wait_valid"] != false || row["probe_reads"] != int64(0) || row["probe_writes"] != int64(0) || row["probe_connection"] != int64(0) || row["connection_relation"] != "not_applicable" {
+			t.Fatal("canceled timer issued I/O or appeared successful")
+		}
+	})
+	t.Run("pacing completes without a Redis client", func(t *testing.T) {
+		p := &commandWaitProfile{mode: "pacing_20ms", io: &commandWaitIO{}}
+		row := p.before(context.Background())
+		p.io.readID.Store(1)
+		p.after(row, commandWaitSnapshot{})
+		if row["pacing_success"] != true || row["command_wait_valid"] != true || row["probe_read_bytes"] != int64(0) || row["probe_write_bytes"] != int64(0) || row["pacing_nanoseconds"].(int64) < int64(20*time.Millisecond) {
+			t.Fatal("pacing did not complete independently of Redis")
+		}
+	})
+	for _, releaseErr := range []error{nil, errors.New("original release outcome")} {
+		t.Run("observer does not replace outcome", func(t *testing.T) {
+			client := goredis.NewClient(&goredis.Options{})
+			defer client.Close()
+			fail := &commandWaitFailHook{}
+			client.AddHook(fail)
+			waitIO := &commandWaitIO{}
+			p := &commandWaitProfile{mode: "same_ping", probe: client, io: waitIO, probeIO: waitIO}
+			outerIO := &compactionReleaseIO{}
+			h := &compactionReleaseHook{io: outerIO, wait: p}
+			calls := 0
+			next := func(context.Context, goredis.Cmder) error {
+				calls++
+				waitIO.readID.Store(1)
+				outerIO.reads.Add(1)
+				outerIO.writes.Add(1)
+				return releaseErr
+			}
+			cmd := goredis.NewCmd(context.Background(), "eval", snapshotControl, 1, "private-fixture-key", "release", "private-fixture-token")
+			got := h.ProcessHook(next)(context.Background(), cmd)
+			if !errors.Is(got, releaseErr) || calls != 1 || fail.calls != 1 || len(h.samples) != 1 || h.samples[0]["probe_success"] != false || h.samples[0]["command_wait_valid"] != false {
+				t.Fatal("observer changed release outcome/call count")
+			}
+			encoded, err := json.Marshal(h.samples)
+			if err != nil || strings.Contains(string(encoded), "private-") || strings.Contains(string(encoded), snapshotControl) {
+				t.Fatal("diagnostic exposed arguments or probe error")
+			}
+		})
+	}
+}
