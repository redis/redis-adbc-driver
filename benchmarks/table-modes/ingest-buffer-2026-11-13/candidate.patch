@@ -0,0 +1,150 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"fmt"
+	"math/big"
+	"reflect"
+	"testing"
+
+	"github.com/apache/arrow-go/v18/arrow"
+	"github.com/apache/arrow-go/v18/arrow/array"
+	"github.com/apache/arrow-go/v18/arrow/memory"
+)
+
+func TestIngestBufferClearsReferencesAndTails(t *testing.T) {
+	var buffer ingestRowBuffer
+	for _, n := range []int{4096, 3, 1024, 0, 4096} {
+		rows := buffer.resize(n, 3)
+		for _, row := range rows {
+			if len(row) != 3 || cap(row) != 3 {
+				t.Fatal("row view can extend into another row")
+			}
+			for _, v := range row {
+				if !reflect.DeepEqual(v, Value{}) {
+					t.Fatal("previous slice leaked a value")
+				}
+			}
+			record := []Value{stringValue("nested")}
+			row[0] = stringValue("owned string")
+			row[1] = Value{D: big.NewInt(123)}
+			row[2] = Value{rec: &record}
+		}
+		buffer.clear()
+		for _, v := range buffer.values[:cap(buffer.values)] {
+			if !reflect.DeepEqual(v, Value{}) {
+				t.Fatal("cleared slice retains string/decimal/record references")
+			}
+		}
+		for _, row := range buffer.rows[:cap(buffer.rows)] {
+			if row != nil {
+				t.Fatal("cleared row view retains a matrix")
+			}
+		}
+	}
+}
+
+// Every iteration is one complete four-slice conversion operation, including
+// initial allocation, owned string copies and a short final slice. The reusable
+// arm also includes its required clearing; the fresh baseline does not.
+// Arrow input construction is outside timing, equally for both controls.
+func BenchmarkIngestBufferConversion(b *testing.B) {
+	for _, width := range []int{8, 105} {
+		for _, stringInput := range []bool{false, true} {
+			kind := "integer"
+			if stringInput {
+				kind = "mixed"
+			}
+			b.Run(fmt.Sprintf("%d/%s", width, kind), func(b *testing.B) {
+				arrays := make([]arrow.Array, width)
+				targets := make([]ColType, width)
+				for c := range arrays {
+					if stringInput && c%3 == 0 {
+						builder := array.NewStringBuilder(memory.DefaultAllocator)
+						for i := 0; i < 1024; i++ {
+							if i%17 == 0 {
+								builder.AppendNull()
+							} else {
+								builder.Append("payload-é")
+							}
+						}
+						arrays[c] = builder.NewArray()
+						builder.Release()
+						targets[c] = typeString
+					} else {
+						builder := array.NewInt64Builder(memory.DefaultAllocator)
+						for i := 0; i < 1024; i++ {
+							if i%17 == 0 {
+								builder.AppendNull()
+							} else {
+								builder.Append(9007199254740993 + int64(i))
+							}
+						}
+						arrays[c] = builder.NewArray()
+						builder.Release()
+						targets[c] = typeInt64
+					}
+				}
+				defer func() {
+					for _, a := range arrays {
+						a.Release()
+					}
+				}()
+				for _, reuse := range []bool{false, true} {
+					name := "fresh"
+					if reuse {
+						name = "reuse"
+					}
+					b.Run(name, func(b *testing.B) {
+						// Full-field reference checks occur before and after timing.
+						checkIngestBufferConversion(b, arrays, targets, reuse)
+						b.ReportAllocs()
+						b.ResetTimer()
+						for op := 0; op < b.N; op++ {
+							runIngestBufferConversion(b, arrays, targets, reuse, false)
+						}
+						b.StopTimer()
+						checkIngestBufferConversion(b, arrays, targets, reuse)
+					})
+				}
+			})
+		}
+	}
+}
+
+func checkIngestBufferConversion(b *testing.B, arrays []arrow.Array, targets []ColType, reuse bool) {
+	runIngestBufferConversion(b, arrays, targets, reuse, true)
+}
+
+func runIngestBufferConversion(b *testing.B, arrays []arrow.Array, targets []ColType, reuse, check bool) {
+	var buffer ingestRowBuffer
+	for _, n := range []int{1024, 1024, 1024, 17} {
+		if !reuse {
+			buffer = ingestRowBuffer{}
+		}
+		rows := buffer.resize(n, len(arrays))
+		for c, a := range arrays {
+			if err := ingestColumn(a, targets[c], utcZone, rows, c); err != nil {
+				b.Fatal(err)
+			}
+		}
+		if check {
+			for r, row := range rows {
+				for c, got := range row {
+					want, err := valueAt(arrays[c], r)
+					if err == nil {
+						want, err = coerceIn(want, targets[c], utcZone)
+					}
+					if err != nil || !reflect.DeepEqual(got, want) {
+						b.Fatalf("row%d column%d got%v want%v error%v", r, c, got, want, err)
+					}
+				}
+			}
+		}
+		if reuse {
+			buffer.clear()
+		}
+	}
+}
