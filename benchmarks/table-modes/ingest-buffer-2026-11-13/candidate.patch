diff --git a/go/ingest_buffer.go b/go/ingest_buffer.go
new file mode 100644
index 00000000..1043131c
--- /dev/null
+++ b/go/ingest_buffer.go
@@ -0,0 +1,37 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+// ingestRowBuffer belongs to a single ingestion execution. The caller clears it
+// after synchronous row insertion, on success or failure, before reading more
+// input. Only bounded conversion slices are retained for reuse.
+type ingestRowBuffer struct {
+	rows   [][]Value
+	values []Value
+}
+
+func (b *ingestRowBuffer) resize(n, columns int) [][]Value {
+	if cap(b.values) < n*columns {
+		b.values = make([]Value, n*columns)
+	} else {
+		b.values = b.values[:n*columns]
+	}
+	if cap(b.rows) < n {
+		b.rows = make([][]Value, n)
+	} else {
+		b.rows = b.rows[:n]
+	}
+	for r := range b.rows {
+		start, end := r*columns, (r+1)*columns
+		b.rows[r] = b.values[start:end:end]
+	}
+	return b.rows
+}
+
+func (b *ingestRowBuffer) clear() {
+	// Values can own strings, decimal integers and nested records. Clear row
+	// views too, so unused view capacity cannot retain an obsolete matrix.
+	clear(b.values)
+	clear(b.rows)
+}
