@@ -0,0 +1,386 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"context"
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/apache/arrow-go/v18/arrow"
+	"github.com/apache/arrow-go/v18/arrow/array"
+	"github.com/apache/arrow-go/v18/arrow/memory"
+)
+
+func batchedArrowFixture(mem memory.Allocator, width, count, batchRows int) (*streamReader, []aggRow) {
+	types := []ColType{typeInt64, typeInt32, typeInt16, typeBool, typeFloat64, typeFloat32,
+		typeDate, typeTimestampTZ, typeString}
+	meta := &tableMeta{Schema: defaultSchema, Name: "batched", KeyPrefix: "batched:"}
+	it := &scanIter{meta: meta, need: map[string]bool{}}
+	var items []planItem
+	var cols []resultColumn
+	for j := range width {
+		name, typ := "c"+strconv.Itoa(j), types[j%len(types)]
+		meta.Columns = append(meta.Columns, columnMeta{Name: name, Type: typ, Nullable: true})
+		it.need[name] = true
+		items = append(items, planItem{expr: &ColumnRef{Name: name}})
+		cols = append(cols, resultColumn{Name: name, Type: typ})
+	}
+	meta.Columns[0].Missing, meta.Columns[0].MissingThrough = "9007199254740993", 2
+	it.projection = newScanProjection(it, items)
+	rows := make([]aggRow, count)
+	for i := range rows {
+		raw := aggRow{rowIDField: strconv.Itoa(i + 1)}
+		for j, c := range meta.Columns {
+			if (i+j)%11 == 0 {
+				continue // NULL, or the first column's historical default.
+			}
+			var text string
+			switch c.Type.Kind {
+			case KindInt64:
+				text = strconv.FormatInt(9007199254740993+int64(i), 10)
+			case KindInt32:
+				text = strconv.Itoa(-2147483000 + i)
+			case KindInt16:
+				text = strconv.Itoa(-1000 + i%2000)
+			case KindBool:
+				text = strconv.Itoa(i % 2)
+			case KindFloat32, KindFloat64:
+				text = strconv.FormatFloat(float64(i)/8-123, 'g', -1, 64)
+				if i%13 == 0 {
+					text = nanStored
+				}
+			case KindDate:
+				text = strconv.Itoa(-1000 + i)
+			case KindTimestamp:
+				text = strconv.FormatInt(1234567890123456+int64(i), 10)
+			case KindString:
+				if i%7 != 0 {
+					text = "payload\x00é:" + strconv.Itoa(i)
+				}
+			}
+			raw[c.Name] = text
+		}
+		rows[i] = raw
+	}
+	r := &streamReader{ctx: context.Background(), it: it, cols: cols, zone: utcZone,
+		batchRows: batchRows, left: -1, mem: mem, schema: resultSchema(cols),
+		arrow: &scanArrow{scratch: make([]Value, width), builder: array.NewRecordBuilder(mem, resultSchema(cols))}}
+	r.batchSizer = newBatchSizer(cols)
+	return r, rows
+}
+
+func finishBatchedArrowForTest(r *streamReader) {
+	if r.arrow.rows == 0 {
+		return
+	}
+	if r.arrow.batched != nil {
+		r.arrow.batched.flush()
+	}
+	r.arrow.ready = append(r.arrow.ready, r.arrow.builder.NewRecordBatch())
+	r.arrow.rows, r.arrow.bytes = 0, 0
+}
+
+func TestBatchedArrowCompleteFieldsAndRetainedOwnership(t *testing.T) {
+	for _, hash := range []bool{false, true} {
+		t.Run(fmt.Sprint(hash), func(t *testing.T) {
+			mem := memory.NewCheckedAllocator(memory.DefaultAllocator)
+			defer mem.AssertSize(t, 0)
+			r, rows := batchedArrowFixture(mem, 105, 131, 65)
+			defer r.arrow.release()
+			// Exercise a duplicate/alias alongside independent required inputs,
+			// and local-time fitting before the already-bound output coercion.
+			items := make([]planItem, len(r.cols))
+			for j, col := range r.cols {
+				items[j].expr = &ColumnRef{Name: col.Name}
+			}
+			items[9].expr, r.cols[9].Name = &ColumnRef{Name: "c0"}, "duplicate_id"
+			r.cols[7].Type, r.zone = typeTimestamp, tzZone{off: 3600}
+			r.it.projection = newScanProjection(r.it, items)
+			r.arrow.builder.Release()
+			r.arrow.builder = array.NewRecordBuilder(mem, resultSchema(r.cols))
+			var hashFields []string
+			if hash {
+				for _, c := range r.it.meta.Columns {
+					hashFields = append(hashFields, c.field())
+				}
+				hashFields = append(hashFields, nullMarker("c0"))
+				if !r.it.projection.bindHash(hashFields) {
+					t.Fatal("HASH binding refused complete fields/default marker")
+				}
+			}
+			var expected [][]Value
+			for _, raw := range rows {
+				row, err := r.it.projection.decode(raw)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := fitRow(row, r.cols, r.zone); err != nil {
+					t.Fatal(err)
+				}
+				expected = append(expected, row)
+				if hash {
+					values := make([]any, len(hashFields)+1)
+					values[0] = raw[rowIDField]
+					for j, f := range hashFields {
+						if value, ok := raw[f]; ok {
+							values[j+1] = value
+						}
+					}
+					err = r.appendArrowHash(values)
+				} else {
+					err = r.appendArrow(raw)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				if r.arrow.batched == nil || r.arrow.batched.rows >= scanArrowBlockRows {
+					t.Fatal("eligible stream did not retain a bounded staging block")
+				}
+			}
+			finishBatchedArrowForTest(r)
+			if len(r.arrow.ready) != 3 {
+				t.Fatal("record boundaries changed", len(r.arrow.ready))
+			}
+			at := 0
+			for _, rec := range r.arrow.ready {
+				n := int(rec.NumRows())
+				if n != min(65, len(rows)-at) {
+					t.Fatal("wrong record tail", n, at)
+				}
+				want, err := buildRecord(mem, r.cols, expected[at:at+n])
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !array.RecordApproxEqual(rec, want, array.WithNaNsEqual(true), array.WithAbsTolerance(0)) {
+					t.Errorf("all-column validation differs at row %d", at)
+				}
+				want.Release()
+				at += n
+			}
+			retained := r.arrow.ready[0]
+			retained.Retain()
+			defer retained.Release()
+			r.arrow.release()
+			if got := retained.Column(0).(*array.Int64).Value(0); got != 9007199254740993 {
+				t.Fatal("retained exact value/default changed", got)
+			}
+			if got := retained.Column(8).(*array.String).Value(1); got != "payload\x00é:1" {
+				t.Fatal("retained variable-width payload changed", got)
+			}
+		})
+	}
+}
+
+func TestBatchedArrowErrorsAndSkippedTail(t *testing.T) {
+	for _, mode := range []string{"partial", "retained", "offset", "limit"} {
+		t.Run(mode, func(t *testing.T) {
+			mem := memory.NewCheckedAllocator(memory.DefaultAllocator)
+			defer mem.AssertSize(t, 0)
+			r, rows := batchedArrowFixture(mem, 105, 65, 64)
+			defer r.arrow.release()
+			// Later-column coercion must fail after preceding string columns
+			// staged the next row, without flushing any of that partial row.
+			const narrow = 99
+			r.cols[narrow].Type = typeInt16
+			r.arrow.builder.Release()
+			r.arrow.builder = array.NewRecordBuilder(mem, resultSchema(r.cols))
+			for i := range rows {
+				rows[i]["c99"] = "12"
+			}
+			n := 63
+			if mode == "retained" {
+				n = 64
+			}
+			if mode == "offset" || mode == "limit" {
+				n = 0
+			}
+			for i := range n {
+				if err := r.appendArrow(rows[i]); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var retained arrow.RecordBatch
+			if mode == "retained" {
+				retained = r.arrow.ready[0]
+				retained.Retain()
+				defer retained.Release()
+			}
+			bad := rows[64]
+			bad["c99"] = "40000" // valid stored BIGINT, invalid SMALLINT output.
+			if mode == "offset" {
+				r.skip = 1
+			} else if mode == "limit" {
+				r.left = 0
+			}
+			if mode == "partial" || mode == "retained" {
+				before := r.arrow.rows
+				if err := r.appendArrow(bad); err == nil || r.arrow.rows != before {
+					t.Fatal("coercion published a partial row", err)
+				}
+			}
+			bad["c103"] = "malformed" // required decode must beat output error/skip.
+			if err := r.appendArrow(bad); err == nil || !strings.Contains(err.Error(), "c103") {
+				t.Fatal("required decode/error ordering changed", err)
+			}
+			r.arrow.release()
+			if retained != nil && retained.Column(narrow).(*array.Int16).Value(0) != 12 {
+				t.Fatal("retained prior batch changed after failure/release")
+			}
+		})
+	}
+}
