+func TestBatchedArrowLimitOffsetAndMetadataErrorOrder(t *testing.T) {
+	mem := memory.NewCheckedAllocator(memory.DefaultAllocator)
+	defer mem.AssertSize(t, 0)
+	r, rows := batchedArrowFixture(mem, 105, 131, 65)
+	defer r.arrow.release()
+	r.skip, r.left = 3, 67
+	var expected [][]Value
+	for i, raw := range rows {
+		if i >= 3 && i < 70 {
+			row, err := r.it.projection.decode(raw)
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected = append(expected, row)
+		}
+		if err := r.appendArrow(raw); err != nil {
+			t.Fatal(err)
+		}
+	}
+	finishBatchedArrowForTest(r)
+	if r.left != 0 || len(r.arrow.ready) != 2 || r.arrow.ready[0].NumRows() != 65 || r.arrow.ready[1].NumRows() != 2 {
+		t.Fatal("limit/offset record boundaries changed")
+	}
+	at := 0
+	for _, rec := range r.arrow.ready {
+		n := int(rec.NumRows())
+		want, err := buildRecord(mem, r.cols, expected[at:at+n])
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !array.RecordApproxEqual(rec, want, array.WithNaNsEqual(true), array.WithAbsTolerance(0)) {
+			t.Error("limited full-field output differs")
+		}
+		want.Release()
+		at += n
+	}
+	// Even the skipped LIMIT tail is validated in metadata order.
+	bad := rows[130]
+	bad["c99"], bad["c103"] = "malformed", "malformed"
+	if err := r.appendArrow(bad); err == nil || !strings.Contains(err.Error(), "c99") {
+		t.Fatal("metadata error ordering changed after LIMIT", err)
+	}
