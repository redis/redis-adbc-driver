+func TestBatchedArrowFallbacks(t *testing.T) {
+	for _, mode := range []string{"narrow", "small_batch", "byte_budget", "time", "fixed_string"} {
+		t.Run(mode, func(t *testing.T) {
+			mem := memory.NewCheckedAllocator(memory.DefaultAllocator)
+			defer mem.AssertSize(t, 0)
+			width, batchRows := 105, 512
+			if mode == "narrow" {
+				width = 8
+			} else if mode == "small_batch" {
+				batchRows = 1
+			}
+			r, rows := batchedArrowFixture(mem, width, 1, batchRows)
+			defer r.arrow.release()
+			if mode == "byte_budget" {
+				r.batchBytes = 256
+			} else if mode == "time" || mode == "fixed_string" {
+				typ := timeType(arrow.Microsecond)
+				text := "1234"
+				if mode == "fixed_string" {
+					typ, text = ColType{Kind: KindString, Fixed: true, Length: 5}, "x"
+				}
+				r.cols[0].Type, r.it.meta.Columns[0].Type = typ, typ
+				r.it.meta.Columns[0].MissingThrough = 0
+				rows[0]["c0"] = text
+				// Reconstruct the same bare references used by the fixture.
+				items := make([]planItem, len(r.cols))
+				for j, col := range r.cols {
+					items[j].expr = &ColumnRef{Name: col.Name}
+				}
+				r.it.projection = newScanProjection(r.it, items)
+				r.arrow.builder.Release()
+				r.arrow.builder = array.NewRecordBuilder(mem, resultSchema(r.cols))
+			}
+			if err := r.appendArrow(rows[0]); err != nil {
+				t.Fatal(err)
+			}
+			if r.arrow.batched != nil {
+				t.Fatal("unsupported stream selected batching")
+			}
+			finishBatchedArrowForTest(r)
+		})
+	}
