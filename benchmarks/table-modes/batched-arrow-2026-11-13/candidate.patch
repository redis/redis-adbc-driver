+func BenchmarkBatchedArrowConstruction(b *testing.B) {
+	for _, width := range []int{8, 105} {
+		for _, count := range []int{63, 1024} {
+			for _, batched := range []bool{false, true} {
+				b.Run(fmt.Sprintf("columns_%d/rows_%d/batched_%t", width, count, batched), func(b *testing.B) {
+					fixture, raws := batchedArrowFixture(memory.DefaultAllocator, width, count, 512)
+					fixture.arrow.release()
+					build := func() *streamReader {
+						r, _ := batchedArrowFixture(memory.DefaultAllocator, width, 0, 512)
+						r.arrow.batchChecked = !batched // baseline-equivalent scalar control.
+						for _, raw := range raws {
+							if err := r.appendArrow(raw); err != nil {
+								b.Fatal(err)
+							}
+						}
+						finishBatchedArrowForTest(r)
+						return r
+					}
+					validate := func(r *streamReader) {
+						at := 0
+						for _, record := range r.arrow.ready {
+							n := int(record.NumRows())
+							rows := make([][]Value, n)
+							for i := range rows {
+								var err error
+								rows[i], err = r.it.projection.decode(raws[at+i])
+								if err != nil {
+									b.Fatal(err)
+								}
+							}
+							want, err := buildRecord(memory.DefaultAllocator, r.cols, rows)
+							if err != nil {
+								b.Fatal(err)
+							}
+							if !array.RecordApproxEqual(record, want, array.WithNaNsEqual(true), array.WithAbsTolerance(0)) {
+								b.Fatal("complete typed field validation differs")
+							}
+							want.Release()
+							at += n
+						}
+						if at != len(raws) {
+							b.Fatal("incomplete Arrow output", at)
+						}
+					}
+					control := build()
+					validate(control)
+					control.arrow.release()
+					b.ReportAllocs()
+					b.ResetTimer()
+					for range b.N {
+						r := build()
+						r.arrow.release()
+					}
+					b.StopTimer()
+					control = build()
+					validate(control)
+					control.arrow.release()
+				})
+			}
+		}
+	}
+}
