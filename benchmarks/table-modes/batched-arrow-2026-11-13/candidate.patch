diff --git a/go/scan_arrow_batch.go b/go/scan_arrow_batch.go
new file mode 100644
index 00000000..d561459e
--- /dev/null
+++ b/go/scan_arrow_batch.go
@@ -0,0 +1,186 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"github.com/apache/arrow-go/v18/arrow/array"
+)
+
+// Bound intermediate storage independently of the public Arrow batch ceiling.
+// A completed row is staged before any bulk append; errors never flush a partial
+// row. The public record/limit boundaries remain owned by scanArrow.
+const scanArrowBlockRows = 64
+
+type scanArrowBatch struct {
+	columns []arrowBatchColumn
+	rows    int
+}
+
+type arrowBatchColumn struct {
+	stage   func(Value)
+	flush   func()
+	discard func()
+}
+
+func newScanArrowBatch(builder *array.RecordBuilder, cols []resultColumn) *scanArrowBatch {
+	// Check everything first, avoiding scratch allocation for a mixed schema
+	// that must use appendValue's complete generic behavior.
+	for j, c := range cols {
+		if !arrowBatchSupported(builder.Field(j), c.Type) {
+			return nil
+		}
+	}
+	b := &scanArrowBatch{columns: make([]arrowBatchColumn, len(cols))}
+	for j := range cols {
+		switch field := builder.Field(j).(type) {
+		case *array.Int16Builder:
+			b.columns[j] = batchIntegerColumn(field.AppendValues)
+		case *array.Int32Builder:
+			b.columns[j] = batchIntegerColumn(field.AppendValues)
+		case *array.Int64Builder:
+			b.columns[j] = batchIntegerColumn(field.AppendValues)
+		case *array.Date32Builder:
+			b.columns[j] = batchIntegerColumn(field.AppendValues)
+		case *array.TimestampBuilder:
+			b.columns[j] = batchIntegerColumn(field.AppendValues)
+		case *array.Float32Builder:
+			b.columns[j] = batchFloatColumn(field.AppendValues)
+		case *array.Float64Builder:
+			b.columns[j] = batchFloatColumn(field.AppendValues)
+		case *array.BooleanBuilder:
+			b.columns[j] = batchBoolColumn(field)
+		case *array.StringBuilder:
+			b.columns[j] = batchStringColumn(field)
+		}
+	}
+	return b
+}
+
+func arrowBatchSupported(builder array.Builder, typ ColType) bool {
+	switch builder.(type) {
+	case *array.Int16Builder:
+		return typ.Kind == KindInt16
+	case *array.Int32Builder:
+		return typ.Kind == KindInt32
+	case *array.Int64Builder:
+		return typ.Kind == KindInt64
+	case *array.Date32Builder:
+		return typ.Kind == KindDate
+	case *array.TimestampBuilder:
+		return typ.Kind == KindTimestamp
+	case *array.Float32Builder:
+		return typ.Kind == KindFloat32
+	case *array.Float64Builder:
+		return typ.Kind == KindFloat64
+	case *array.BooleanBuilder:
+		return typ.Kind == KindBool
+	case *array.StringBuilder:
+		return typ.Kind == KindString && !typ.Fixed
+	}
+	return false
+}
+
+func (b *scanArrowBatch) append(typed []typedArrowColumn, row []Value) error {
+	for j, column := range b.columns {
+		value, err := typed[j].coerce(row[j])
+		if err != nil {
+			return err
+		}
+		column.stage(value)
+	}
+	b.rows++
+	if b.rows == scanArrowBlockRows {
+		b.flush()
+	}
+	return nil
+}
+
+func (b *scanArrowBatch) flush() {
+	if b.rows == 0 {
+		return
+	}
+	for _, column := range b.columns {
+		column.flush()
+	}
+	b.rows = 0
+}
+
+func (b *scanArrowBatch) release() {
+	for _, column := range b.columns {
+		if column.discard != nil {
+			column.discard()
+		}
+	}
+	b.columns = nil
+	b.rows = 0
+}
+
+func batchIntegerColumn[T ~int16 | ~int32 | ~int64](appendValues func([]T, []bool)) arrowBatchColumn {
+	values := make([]T, 0, scanArrowBlockRows)
+	valid := make([]bool, 0, scanArrowBlockRows)
+	return arrowBatchColumn{
+		stage: func(value Value) {
+			values = append(values, T(value.I))
+			valid = append(valid, !value.Null)
+		},
+		flush: func() {
+			appendValues(values, valid)
+			values, valid = values[:0], valid[:0]
+		},
+	}
+}
+
+func batchFloatColumn[T ~float32 | ~float64](appendValues func([]T, []bool)) arrowBatchColumn {
+	values := make([]T, 0, scanArrowBlockRows)
+	valid := make([]bool, 0, scanArrowBlockRows)
+	return arrowBatchColumn{
+		stage: func(value Value) {
+			values = append(values, T(value.F))
+			valid = append(valid, !value.Null)
+		},
+		flush: func() {
+			appendValues(values, valid)
+			values, valid = values[:0], valid[:0]
+		},
+	}
+}
+
+func batchBoolColumn(builder *array.BooleanBuilder) arrowBatchColumn {
+	values := make([]bool, 0, scanArrowBlockRows)
+	valid := make([]bool, 0, scanArrowBlockRows)
+	return arrowBatchColumn{
+		stage: func(value Value) {
+			values = append(values, value.I != 0)
+			valid = append(valid, !value.Null)
+		},
+		flush: func() {
+			builder.AppendValues(values, valid)
+			values, valid = values[:0], valid[:0]
+		},
+	}
+}
+
+func batchStringColumn(builder *array.StringBuilder) arrowBatchColumn {
+	values := make([]string, 0, scanArrowBlockRows)
+	valid := make([]bool, 0, scanArrowBlockRows)
+	clearValues := func() {
+		clear(values)
+		values, valid = values[:0], valid[:0]
+	}
+	return arrowBatchColumn{
+		stage: func(value Value) {
+			text := ""
+			if !value.Null {
+				text = value.S
+			}
+			values = append(values, text)
+			valid = append(valid, !value.Null)
+		},
+		flush: func() {
+			builder.AppendValues(values, valid)
+			clearValues()
+		},
+		discard: clearValues,
+	}
+}
