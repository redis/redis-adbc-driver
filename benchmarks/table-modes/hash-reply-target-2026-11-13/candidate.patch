+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"context"
+	"math"
+
+	"github.com/apache/arrow-adbc/go/adbc"
+)
+
+// hashReplyTargetBytes is an internal retained-reply target per prefetched HASH
+// chunk. There may be one consumer chunk and one lookahead chunk. This is NOT
+// a hard wire, heap or RSS bound: Redis supplies unknown-length values and the
+// generic decoder owns each complete reply before its size can be observed.
+// A later larger row can overshoot the estimate; one row always makes progress.
+// Arrow buffers, key-discovery pages, allocator slack and caller-retained records
+// are separate. Existing discovery/server limits and the row ceiling still apply.
+const hashReplyTargetBytes int64 = 16 << 20
+
+type hashReplyTarget struct {
+	bytes    int64
+	maxRows  int
+	rowFloor int64
+	rowBytes int64
+	limit    int
+}
+
+func newHashReplyTarget(bytes int64, maxRows, fields int) *hashReplyTarget {
+	// Each field gets a conservative initial allowance for argument/reply
+	// interface slots, an owned string header and a modest payload. Larger
+	// observations shrink immediately; smaller chunks recover at most 2x at a
+	// time so an isolated large value cannot strand the rest at one-row reads.
+	fieldCount := int64(max(0, fields))
+	rowBytes := int64(math.MaxInt64)
+	if fieldCount <= (math.MaxInt64-128)/64 {
+		rowBytes = fieldCount*64 + 128
+	}
+	t := &hashReplyTarget{bytes: max(int64(1), bytes), maxRows: max(1, maxRows), rowFloor: rowBytes, rowBytes: rowBytes}
+	t.limit = t.rowsFor(rowBytes)
+	return t
+}
+
+func (t *hashReplyTarget) rows() int { return t.limit }
+
+func (t *hashReplyTarget) rowsFor(rowBytes int64) int {
+	rows := min(int64(t.maxRows), max(int64(1), t.bytes/rowBytes))
+	// Keep ordinary numeric pages reasonably aligned, without ever rounding a
+	// small server/discovery limit up or admitting zero rows.
+	if rows >= snapshotDeltaPage {
+		rows -= rows % snapshotDeltaPage
+	}
+	return int(rows)
+}
+
+func (t *hashReplyTarget) observe(keys []string, values [][]any) {
+	observed := t.rowFloor
+	for i, row := range values {
+		// Slice/interface/string accounting is conservative sizing, not an
+		// allocator measurement. Include key storage and boxed owned strings.
+		n := int64(24 + 32*len(row) + 32)
+		if i < len(keys) {
+			n = addBatchBytes(n, int64(len(keys[i])))
+		}
+		for _, value := range row {
+			switch value := value.(type) {
+			case string:
+				n = addBatchBytes(n, addBatchBytes(32, int64(len(value))))
+			case []byte:
+				n = addBatchBytes(n, addBatchBytes(32, int64(cap(value))))
+			}
+		}
+		observed = max(observed, n)
+	}
+	t.rowBytes = observed
+	t.limit = min(t.rowsFor(observed), max(1, t.limit*2))
+}
+
+// snapshotHashReplyFetcher keeps exact discovery/visibility pages unchanged,
+// but materializes their winning HASH replies in independently owned chunks.
+// Only this worker owns pending key slices and the target; the consumer owns
+// delivered reply slices through conversion. No reply/argument storage is reused.
+func snapshotHashReplyFetcher(
+	discover func(context.Context) ([]string, []string, error),
+	fetch func(context.Context, []string) ([][]any, error),
+	target *hashReplyTarget,
+) func(context.Context) hashPage {
+	var logical, physical []string
+	at := 0
+	return func(ctx context.Context) hashPage {
+		if err := cancelled(ctx); err != nil {
+			return hashPage{err: err}
+		}
+		if at == len(physical) {
+			var err error
+			logical, physical, err = discover(ctx)
+			at = 0
+			if err != nil {
+				return hashPage{err: err}
+			}
+			if len(logical) != len(physical) {
+				return hashPage{err: errorf(adbc.StatusInternal, "snapshot discovery returned mismatched keys")}
+			}
+		}
+		// A candidate page may contain only shadowed rows. Preserve progress
+		// to the next discovery page rather than turning it into successful EOF.
+		if len(physical) == 0 {
+			return hashPage{snapshot: true}
+		}
+		end := min(len(physical), at+target.rows())
+		keys := logical[at:end]
+		values, err := fetch(ctx, physical[at:end])
+		if err != nil {
+			return hashPage{err: err}
+		}
+		if len(values) != len(keys) {
+			return hashPage{err: errorf(adbc.StatusInternal, "snapshot fetch returned mismatched rows")}
+		}
+		target.observe(keys, values)
+		at = end
+		return hashPage{keys: keys, values: values, snapshot: true}
+	}
+}
