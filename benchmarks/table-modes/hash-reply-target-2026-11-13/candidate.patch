+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+
+package redis
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/apache/arrow-adbc/go/adbc"
+	"github.com/apache/arrow-go/v18/arrow"
+	"github.com/apache/arrow-go/v18/arrow/array"
+	"github.com/apache/arrow-go/v18/arrow/memory"
+)
+
+func hashTargetString(id int64) (string, bool) {
+	if id%1000 == 0 {
+		return strings.Repeat("λ\x00", 8192) + strconv.FormatInt(id, 10), false
+	}
+	return memoryString(id)
+}
+
+func hashTargetRecord(rows int) arrow.RecordBatch {
+	base := memoryRecord(rows)
+	defer base.Release()
+	columns := make([]arrow.Array, int(base.NumCols()))
+	for i := range columns {
+		columns[i] = base.Column(i)
+	}
+	b := array.NewStringBuilder(memory.DefaultAllocator)
+	for id := int64(1); id <= int64(rows); id++ {
+		value, null := hashTargetString(id)
+		if null {
+			b.AppendNull()
+		} else {
+			b.Append(value)
+		}
+	}
+	strings := b.NewArray()
+	b.Release()
+	defer strings.Release()
+	columns[104] = strings
+	return array.NewRecordBatch(base.Schema(), columns, int64(rows))
+}
+
+func validateHashTargetRecord(t *testing.T, rec arrow.RecordBatch, seen []bool) {
+	t.Helper()
+	if rec.NumCols() != 105 {
+		t.Fatal("wrong target fixture width", rec.NumCols())
+	}
+	ids := rec.Column(0).(*array.Int64)
+	for row := 0; row < int(rec.NumRows()); row++ {
+		id := ids.Value(row)
+		if id < 1 || id > int64(len(seen)) || seen[id-1] {
+			t.Fatal("invalid or duplicate target row", id)
+		}
+		seen[id-1] = true
+		for col := 0; col < 104; col++ {
+			a := rec.Column(col).(*array.Int64)
+			null := col == 1 && id%17 == 0
+			if a.IsNull(row) != null || !null && a.Value(row) != followupValue(id, col) {
+				t.Fatal("incorrect target integer/NULL", id, col)
+			}
+		}
+		a := rec.Column(104).(*array.String)
+		value, null := hashTargetString(id)
+		if a.IsNull(row) != null || !null && a.Value(row) != value {
+			t.Fatal("incorrect target variable string/NULL", id)
+		}
+	}
+}
+
+// The source can publish newer rows or disappear while a reply chunk is queued
+// and the worker still owns unfetched keys from an earlier exact discovery page.
+// The statement's immutable source pin and each output record must remain valid.
+func TestSnapshotHashReplyTargetPinnedDiscovery(t *testing.T) {
+	for _, candidate := range []bool{false, true} {
+		t.Run(fmt.Sprintf("candidate_%t", candidate), func(t *testing.T) {
+			h, _, _ := newSnapshotHarnessMode(t, false, false)
+			const table = "reply_target_pin"
+			const rows = 5001
+			rec := hashTargetRecord(rows)
+			defer rec.Release()
+			if err := followupIngest(h.ctx, h.conn, table, adbc.OptionValueIngestModeCreate, rec); err != nil {
+				t.Fatal(err)
+			}
+			if !candidate {
+				for _, suffix := range []string{" LIMIT 4500", " OFFSET 1", " LIMIT 4500 OFFSET 1"} {
+					st, limited, _ := h.openStmtStream(h.ctx, h.conn, "SELECT * FROM "+table+suffix, nil,
+						map[string]string{OptionIntStreamBatchRows: "512"})
+					stream, ok := inspectionReader(limited).(*streamReader)
+					if !ok || stream.it == nil || !stream.it.preserveHashPage {
+						t.Fatal("pagination exclusion was not set before initial fill", suffix)
+					}
+					seen := make([]bool, rows)
+					for limited.Next() {
+						validateHashTargetRecord(t, limited.RecordBatch(), seen)
+					}
+					if err := limited.Err(); err != nil {
+						t.Fatal(err)
+					}
+					limited.Release()
+					st.Close(h.ctx)
+					first, last := 1, rows
+					if strings.Contains(suffix, "OFFSET") {
+						first++
+					}
+					if strings.Contains(suffix, "LIMIT") {
+						last = first + 4499
+					}
+					for id, present := range seen {
+						if present != (id+1 >= first && id+1 <= last) {
+							t.Fatal("pagination result changed", suffix, id+1, present)
+						}
+					}
+				}
+			}
+			query := "SELECT * FROM " + table
+			if candidate {
+				query += " WHERE id >= 1"
+			}
+			_, reader, count := h.openStmtStream(h.ctx, h.conn, query, nil,
+				map[string]string{OptionIntStreamBatchRows: "512"})
+			defer reader.Release()
+			if count != -1 || !reader.Next() {
+				t.Fatal("fixture did not stream", count, reader.Err())
+			}
+			stream := inspectionReader(reader).(*streamReader)
+			if stream.it == nil || stream.it.prefetch == nil || !stream.it.hashFetch {
+				t.Fatal("fixture did not use managed HASH lookahead")
+			}
+			retained := reader.RecordBatch()
+			retained.Retain()
+			defer retained.Release()
+			seen := make([]bool, rows)
+			validateHashTargetRecord(t, retained, seen)
+			h.exec("UPDATE " + table + " SET c1=0 WHERE id=1")
+			h.exec("DELETE FROM " + table + " WHERE id=2")
+			h.exec("TRUNCATE " + table)
+			h.exec("DROP TABLE " + table)
+			for reader.Next() {
+				validateHashTargetRecord(t, reader.RecordBatch(), seen)
+			}
+			if err := reader.Err(); err != nil {
+				t.Fatal(err)
+			}
+			for _, present := range seen {
+				if !present {
+					t.Fatal("pending discovery tail lost after later source publication/drop")
+				}
+			}
+			validateHashTargetRecord(t, retained, make([]bool, rows))
+		})
+	}
+}
