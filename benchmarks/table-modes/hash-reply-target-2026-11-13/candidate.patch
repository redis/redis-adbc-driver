+)
+
+func TestHashReplyTargetWidthAndRecovery(t *testing.T) {
+	narrow := newHashReplyTarget(hashReplyTargetBytes, wideFetchChunk, 2)
+	wide := newHashReplyTarget(hashReplyTargetBytes, wideFetchChunk, 108)
+	if narrow.rows() != wideFetchChunk || wide.rows() >= narrow.rows() || wide.rows() < 1 {
+		t.Fatal("initial target did not distinguish field width", narrow.rows(), wide.rows())
+	}
+	for _, maxRows := range []int{1, 137, 256, 1000, 4096} {
+		budget := newHashReplyTarget(hashReplyTargetBytes, maxRows, 108)
+		if budget.rows() < 1 || budget.rows() > maxRows {
+			t.Fatal("target exceeded original row cap", maxRows, budget.rows())
+		}
+	}
+	large := strings.Repeat("x", int(hashReplyTargetBytes)+1)
+	wide.observe([]string{"row"}, [][]any{{large}})
+	if wide.rows() != 1 || wide.rowBytes <= wide.bytes {
+		t.Fatal("oversized row did not shrink future target to one", wide.rows(), wide.rowBytes)
+	}
+	prior := wide.rows()
+	for i := 0; i < 20 && wide.rows() < 1024; i++ {
+		wide.observe([]string{"row"}, [][]any{{"small"}})
+		if wide.rows() < prior || wide.rows() > prior*2 || wide.rows() > wideFetchChunk {
+			t.Fatal("small-row recovery was not bounded", prior, wide.rows())
+		}
+		prior = wide.rows()
+	}
+	if wide.rows() < 1024 {
+		t.Fatal("single large outlier stranded the remaining query at tiny chunks", wide.rows())
+	}
+	// Pathological internal estimates saturate rather than wrapping into a
+	// huge row count. No zero-sized fetch can stall a pending discovery page.
+	if rows := newHashReplyTarget(1, 0, math.MaxInt).rows(); rows != 1 {
+		t.Fatal("invalid target failed to make progress", rows)
+	}
+}
+
+func TestSnapshotHashReplyTargetPreservesDiscoveryAndTail(t *testing.T) {
+	ctx := context.Background()
+	client := goredis.NewClient(&goredis.Options{Protocol: 3})
+	defer client.Close()
+	it := &scanIter{meta: &tableMeta{KeyPrefix: "logical:"}, store: &store{client: client}}
+	for j := 0; j < 105; j++ {
+		it.fetch = append(it.fetch, fmt.Sprintf("c%d", j))
+	}
+	hook := &hashSliceHook{t: t, rows: map[string][]any{}, fields: append(append([]string(nil), it.fetch...), snapshotDeletedField)}
+	client.AddHook(hook)
+	const rows = wideFetchChunk + 3
+	const firstID int64 = 9007199254740993
+	ids := make([]string, rows)
+	for i := range ids {
+		id := strconv.FormatInt(firstID+int64(i), 10)
+		ids[i] = fmt.Sprintf("%020d", firstID+int64(i))
+		value := make([]any, len(it.fetch)+2)
+		value[0], value[1], value[2], value[3], value[5] = id, id, "9223372036854775807", "a\x00λ", ""
+		if i%257 == 0 {
+			value[len(value)-1] = "1" // winning tombstone stays aligned
+		}
+		hook.rows["physical:"+id] = value
+	}
+	it.delta = &snapshotDeltaScan{meta: it.meta, pageRows: wideFetchChunk, directoryPageRows: wideFetchChunk,
+		sources: []snapshotDeltaSource{{segment: snapshotSegment{Prefix: "physical:", Rows: rows}, ids: ids, done: true}}}
+	fetch := it.prefetchedHashFetcher()
+	var chunks []int
+	var all []string
+	var retained hashPage
+	for {
+		page := fetch(ctx)
+		if errors.Is(page.err, io.EOF) {
+			break
+		}
+		if page.err != nil || !page.snapshot || len(page.keys) != len(page.values) {
+			t.Fatal("invalid snapshot chunk", page.err)
+		}
+		if len(chunks) == 0 {
+			retained = page
+			if len(page.keys) >= wideFetchChunk {
+				t.Fatal("wide snapshot fetched the full discovery page as one reply")
+			}
+		}
+		chunks = append(chunks, len(page.keys))
+		for i, key := range page.keys {
+			id := strings.TrimPrefix(key, "logical:")
+			if page.values[i][0] != id || page.values[i][1] != id || page.values[i][2] != "9223372036854775807" ||
+				page.values[i][3] != "a\x00λ" || page.values[i][4] != nil || page.values[i][5] != "" {
+				t.Fatal("logical/physical keys or exact/NULL/empty/binary values changed", key)
+			}
+			original := hook.rows["physical:"+id]
+			if page.values[i][len(page.values[i])-1] != original[len(original)-1] {
+				t.Fatal("tombstone moved to a different logical row")
+			}
+			all = append(all, key)
+		}
+	}
+	if len(all) != rows || len(chunks) < 3 || chunks[len(chunks)-1] != 3 {
+		t.Fatal("discovery tail was lost or duplicated", len(all), chunks)
+	}
+	if it.delta.pageRows != wideFetchChunk || it.delta.directoryPageRows != wideFetchChunk {
+		t.Fatal("reply targeting changed authoritative discovery bounds")
+	}
+	for i, key := range all {
+		if key != "logical:"+strconv.FormatInt(firstID+int64(i), 10) {
+			t.Fatal("chunk order/identity changed", i, key)
+		}
+	}
+	if retained.values[0][0] != strconv.FormatInt(firstID, 10) || retained.keys[0] != all[0] {
+		t.Fatal("later fetches reused an earlier consumer's reply/key storage")
+	}
+}
+
+func TestSnapshotHashReplyFetcherEmptyPageCancelAndErrors(t *testing.T) {
+	for _, mode := range []string{"complete", "cancel", "fetch_error", "discovery_error", "missing_row"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			discoveryCalls, fetchCalls := 0, 0
+			wantErr := errors.New("read failed")
+			fetch := snapshotHashReplyFetcher(func(context.Context) ([]string, []string, error) {
+				discoveryCalls++
+				if discoveryCalls == 1 {
+					return nil, nil, nil // all candidates shadowed, not EOF
+				}
+				if discoveryCalls == 2 {
+					if mode == "discovery_error" {
+						return nil, nil, wantErr
+					}
+					return []string{"logical:1", "logical:2", "logical:3"}, []string{"physical:1", "physical:2", "physical:3"}, nil
+				}
+				return nil, nil, io.EOF
+			}, func(_ context.Context, keys []string) ([][]any, error) {
+				fetchCalls++
+				if mode == "fetch_error" {
+					return nil, wantErr
+				}
+				values := make([][]any, len(keys))
+				for i, key := range keys {
+					id := strings.TrimPrefix(key, "physical:")
+					if mode != "missing_row" || id != "2" {
+						values[i] = []any{id, "value", nil}
+					}
+				}
+				return values, nil
+			}, newHashReplyTarget(1, 2, 3))
+			if page := fetch(ctx); page.err != nil || len(page.keys) != 0 || fetchCalls != 0 {
+				t.Fatal("empty candidate page did not preserve progress without fetching", page.err)
+			}
+			var keys []string
+			for {
+				page := fetch(ctx)
+				if errors.Is(page.err, io.EOF) {
+					break
+				}
+				if mode == "fetch_error" || mode == "discovery_error" {
+					if !errors.Is(page.err, wantErr) {
+						t.Fatal("read error was lost", page.err)
+					}
+					break
+				}
+				if page.err != nil {
+					t.Fatal(page.err)
+				}
+				if mode == "missing_row" && page.values[0] == nil {
+					it := &scanIter{meta: &tableMeta{KeyPrefix: "logical:"}, env: &evalEnv{ctx: ctx}, projection: &scanProjection{consumeHash: func([]any) error { return nil }}}
+					if _, _, err := it.consumeSnapshotHashValues(ctx, page.keys, page.values); !isStatus(err, adbc.StatusIO) {
+						t.Fatal("missing immutable row became omission", err)
+					}
+					break
+				}
+				keys = append(keys, page.keys...)
+				if mode == "cancel" {
+					cancel()
+					if got := fetch(ctx); !isStatus(got.err, adbc.StatusCancelled) || fetchCalls != 1 || discoveryCalls != 2 {
+						t.Fatal("cancellation fetched or rediscovered pending keys", got.err, fetchCalls, discoveryCalls)
+					}
+					break
+				}
+			}
+			if mode == "complete" && !reflect.DeepEqual(keys, []string{"logical:1", "logical:2", "logical:3"}) {
+				t.Fatal("partial chunks lost pending keys", keys)
+			}
+		})
+	}
+}
+
+func TestSnapshotHashReplyFetcherUnexpectedWidthIsTerminal(t *testing.T) {
+	for _, discoveryMismatch := range []bool{false, true} {
+		fetchCalls := 0
+		fetch := snapshotHashReplyFetcher(func(context.Context) ([]string, []string, error) {
+			if discoveryMismatch {
+				return []string{"logical:1"}, nil, nil
+			}
+			return []string{"logical:1"}, []string{"physical:1"}, nil
+		}, func(context.Context, []string) ([][]any, error) { fetchCalls++; return nil, nil }, newHashReplyTarget(1, 1, 2))
+		p := newHashPagePrefetch(context.Background(), fetch)
+		if page := p.next(context.Background()); !isStatus(page.err, adbc.StatusInternal) {
+			t.Fatal("malformed internal page was accepted", page.err)
+		}
+		awaitPrefetch(t, p.done)
+		p.close()
+		wantFetch := 1
+		if discoveryMismatch {
+			wantFetch = 0
+		}
+		if fetchCalls != wantFetch {
+			t.Fatal("terminal failure was retried", fetchCalls)
+		}
+	}
+}
+
+func TestSnapshotHashReplyUnknownPayloadCanOvershootTarget(t *testing.T) {
+	ctx := context.Background()
+	discovered := false
+	payload := "\x00" + strings.Repeat("λ", 1024)
+	var chunks []int
+	fetch := snapshotHashReplyFetcher(func(context.Context) ([]string, []string, error) {
+		if discovered {
+			return nil, nil, io.EOF
+		}
+		discovered = true
+		keys := []string{"1", "2", "3", "4", "5", "6"}
+		return keys, keys, nil
+	}, func(_ context.Context, keys []string) ([][]any, error) {
+		chunks = append(chunks, len(keys))
+		values := make([][]any, len(keys))
+		for i := range keys {
+			values[i] = []any{payload}
+		}
+		return values, nil
+	}, newHashReplyTarget(1024, 4, 1))
+	var all []string
+	for {
+		page := fetch(ctx)
+		if errors.Is(page.err, io.EOF) {
+			break
+		}
+		if page.err != nil {
+			t.Fatal("adaptive target rejected an oversized valid value", page.err)
+		}
+		for _, row := range page.values {
+			if row[0] != payload {
+				t.Fatal("adaptive target truncated a string")
+			}
+		}
+		all = append(all, page.keys...)
+	}
+	if !reflect.DeepEqual(chunks, []int{4, 1, 1}) || len(all) != 6 {
+		t.Fatal("unknown initial payload was not retained/shrunk on later chunks", chunks, all)
+	}
+}
+
+func TestSnapshotHashReplyTargetPreservesLimitedPages(t *testing.T) {
+	one := int64(1)
+	for _, tc := range []struct {
+		name     string
+		sel      *SelectStmt
+		preserve bool
+	}{
+		{"unlimited", &SelectStmt{}, false},
+		{"limit", &SelectStmt{Limit: &one}, true},
+		{"offset", &SelectStmt{Offset: &one}, true},
+		{"limit_offset", &SelectStmt{Limit: &one, Offset: &one}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			it := &scanIter{}
+			it.preserveHashPageForLimits(tc.sel)
+			// The planner may clear pushed pagination during a cap rewrite, or
+			// DISTINCT construction may pass the stripped inner plan afterward.
+			it.preserveHashPageForLimits(&SelectStmt{})
+			if it.preserveHashPage != tc.preserve {
+				t.Fatal("SQL pagination geometry lost", it.preserveHashPage)
+			}
+			if tc.preserve {
+				client := goredis.NewClient(&goredis.Options{Protocol: 3})
+				defer client.Close()
+				it.meta, it.store = &tableMeta{KeyPrefix: "logical:"}, &store{client: client}
+				for j := 0; j < 105; j++ {
+					it.fetch = append(it.fetch, fmt.Sprintf("c%d", j))
+				}
+				hook := &hashSliceHook{t: t, rows: map[string][]any{}, fields: append(append([]string(nil), it.fetch...), snapshotDeletedField)}
+				client.AddHook(hook)
+				ids := make([]string, wideFetchChunk)
+				for i := range ids {
+					id := strconv.Itoa(i + 1)
+					ids[i] = fmt.Sprintf("%020d", i+1)
+					hook.rows["physical:"+id] = make([]any, len(it.fetch)+2)
+				}
+				it.delta = &snapshotDeltaScan{meta: it.meta, pageRows: wideFetchChunk, directoryPageRows: wideFetchChunk,
+					sources: []snapshotDeltaSource{{segment: snapshotSegment{Prefix: "physical:", Rows: wideFetchChunk}, ids: ids, done: true}}}
+				page := it.prefetchedHashFetcher()(context.Background())
+				if page.err != nil || len(page.keys) != wideFetchChunk {
+					t.Fatal("limited final discovery page was subdivided", len(page.keys), page.err)
+				}
+			}
+		})
+	}
+}
