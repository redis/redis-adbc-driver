+func (it *scanIter) preserveHashPageForLimits(sel *SelectStmt) {
+	// Capture the SQL shape before the first fill, including when a runtime cap
+	// rewrites a pushed limit into a consumer limit. Smaller reply chunks could
+	// otherwise stop before validating the established final discovery-page tail.
+	it.preserveHashPage = it.preserveHashPage || sel != nil && (sel.Limit != nil || sel.Offset != nil)
+}
+
+// Ordinary cursor and narrow/generic paths keep their established fetch shape.
+// Managed snapshot discovery retains its exact source pages and visibility proofs;
+// only the materialized HASH response is divided by an adaptive byte target.
+func (it *scanIter) prefetchedHashFetcher() func(context.Context) hashPage {
+	if it.preserveHashPage || len(it.fetch) < 64 || it.candidates == nil && it.delta == nil {
+		return it.fetchHashPage
+	}
+	var discover func(context.Context) ([]string, []string, error)
+	if it.candidates != nil {
+		discover = it.candidates.nextKeys
+	} else {
+		discover = it.delta.nextKeys
+	}
+	fields := append(append([]string(nil), it.fetch...), snapshotDeletedField)
+	return snapshotHashReplyFetcher(discover, func(ctx context.Context, keys []string) ([][]any, error) {
+		return it.store.fetchRowSlices(ctx, keys, fields, wideFetchChunk)
+	}, newHashReplyTarget(hashReplyTargetBytes, wideFetchChunk, len(fields)+1))
+}
