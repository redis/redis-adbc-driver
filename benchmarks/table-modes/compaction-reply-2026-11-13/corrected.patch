+func TestSnapshotCompactionCommandstats(t *testing.T) {
+	valid := "# Commandstats\r\ncmdstat_eval:calls=4,usec=12,usec_per_call=3.00,rejected_calls=0,failed_calls=0\r\ncmdstat_evalsha:calls=5,usec=21,usec_per_call=4.20,rejected_calls=2,failed_calls=1\r\ncmdstat_hget:calls=500,usec=123\r\n"
+	got, err := compactionParseScriptStats(valid)
+	if err != nil || got != (compactionScriptStats{Calls: 9, Microseconds: 33, Rejected: 2, Failed: 1}) {
+		t.Fatal("invalid aggregate", got, err)
+	}
+	for name, bad := range map[string]string{
+		"empty": "", "unrelated": "cmdstat_hget:calls=1,usec=2", "missing_calls": "cmdstat_eval:usec=2", "missing_usec": "cmdstat_eval:calls=1", "negative": "cmdstat_eval:calls=-1,usec=2", "malformed": "cmdstat_eval:calls=x,usec=2", "duplicate_counter": "cmdstat_eval:calls=1,calls=1,usec=2", "duplicate_command": "cmdstat_eval:calls=1,usec=2\ncmdstat_eval:calls=1,usec=2", "overflow": "cmdstat_eval:calls=9223372036854775807,usec=2\ncmdstat_evalsha:calls=1,usec=2", "invalid_rejected": "cmdstat_eval:calls=1,usec=2,rejected_calls=x", "missing_equals": "cmdstat_eval:calls,usec=2",
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := compactionParseScriptStats(bad); err == nil {
+				t.Fatal("accepted invalid counters")
+			}
+		})
+	}
+	// Unknown operational fields and unrelated commands must never reach JSON.
+	got, err = compactionParseScriptStats("cmdstat_eval:calls=1,usec=2,private=SECRET\ncmdstat_SECRET:calls=1,usec=2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := json.Marshal(got)
+	if err != nil || strings.Contains(string(data), "SECRET") || string(data) != "{\"calls\":1,\"microseconds\":2,\"rejected\":0,\"failed\":0}" {
+		t.Fatal("unsafe profile shape")
+	}
+	before := compactionScriptStats{Calls: 10, Microseconds: 100, Rejected: 3, Failed: 2}
+	after := compactionScriptStats{Calls: 11, Microseconds: 104, Rejected: 3, Failed: 2}
+	delta, err := compactionScriptStatsDelta(before, after)
+	if err != nil || delta != (compactionScriptStats{Calls: 1, Microseconds: 4}) {
+		t.Fatal("wrong delta", delta, err)
+	}
+	for name, bad := range map[string]compactionScriptStats{
+		"none": before, "concurrent": {Calls: 12, Microseconds: 104, Rejected: 3, Failed: 2}, "reset": {Calls: 11, Microseconds: 99, Rejected: 3, Failed: 2}, "rejected": {Calls: 11, Microseconds: 104, Rejected: 4, Failed: 2}, "failed": {Calls: 11, Microseconds: 104, Rejected: 3, Failed: 3},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := compactionScriptStatsDelta(before, bad); err == nil {
+				t.Fatal("accepted contaminated counters")
+			}
+		})
+	}
+}
+
+// A diagnostic counter failure cannot turn acknowledged cleanup into a failed
+// release and trigger the pin's explicit retry. This is endpoint-free.
+type compactionCommandstatsReply struct{}
+
+func (compactionCommandstatsReply) DialHook(next goredis.DialHook) goredis.DialHook { return next }
+func (compactionCommandstatsReply) ProcessPipelineHook(next goredis.ProcessPipelineHook) goredis.ProcessPipelineHook {
+	return next
+}
+func (compactionCommandstatsReply) ProcessHook(next goredis.ProcessHook) goredis.ProcessHook {
+	return func(ctx context.Context, cmd goredis.Cmder) error {
+		if cmd.Name() != "info" {
+			return errors.New("unexpected diagnostic command")
+		}
+		cmd.(*goredis.StringCmd).SetVal("cmdstat_eval:calls=10,usec=100")
+		return nil
+	}
+}
+func TestSnapshotCompactionCommandstatsObservationPreservesRelease(t *testing.T) {
+	monitor := goredis.NewClient(&goredis.Options{})
+	defer monitor.Close()
+	monitor.AddHook(compactionCommandstatsReply{})
+	for _, original := range []error{nil, errors.New("original release failure")} {
+		observer := &compactionReleaseHook{io: &compactionReleaseIO{}, monitor: monitor}
+		called := 0
+		next := observer.ProcessHook(func(ctx context.Context, cmd goredis.Cmder) error { called++; return original })
+		cmd := goredis.NewCmd(context.Background(), "EVAL", snapshotControl, 1, "private-key", "release")
+		got := next(context.Background(), cmd)
+		if got != original || called != 1 || len(observer.samples) != 1 || observer.samples[0]["commandstats_valid"] != false {
+			t.Fatal("observation changed release outcome", got, called, observer.samples)
+		}
+		encoded, err := json.Marshal(observer.samples)
+		if err != nil || strings.Contains(string(encoded), "private-key") || strings.Contains(string(encoded), "original release failure") {
+			t.Fatal("unsafe diagnostic report")
+		}
+	}
+}
