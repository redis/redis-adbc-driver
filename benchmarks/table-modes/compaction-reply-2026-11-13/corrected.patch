+// Only fixed aggregate counters leave the INFO parser. Do not put raw INFO or
+// command error text in profile output; they can contain operational details.
+type compactionScriptStats struct {
+	Calls        int64 `json:"calls"`
+	Microseconds int64 `json:"microseconds"`
+	Rejected     int64 `json:"rejected"`
+	Failed       int64 `json:"failed"`
+}
+
+func compactionParseScriptStats(info string) (compactionScriptStats, error) {
+	var total compactionScriptStats
+	found := false
+	seen := map[string]bool{}
+	for _, line := range strings.Split(info, "\n") {
+		line = strings.TrimSpace(line)
+		name, fields, ok := strings.Cut(line, ":")
+		if !ok || (name != "cmdstat_eval" && name != "cmdstat_evalsha") {
+			continue
+		}
+		if seen[name] {
+			return total, fmt.Errorf("duplicate script commandstats command")
+		}
+		seen[name] = true
+		values := map[string]int64{}
+		for _, field := range strings.Split(fields, ",") {
+			key, value, ok := strings.Cut(field, "=")
+			if key != "calls" && key != "usec" && key != "rejected_calls" && key != "failed_calls" {
+				continue
+			}
+			if !ok {
+				return total, fmt.Errorf("invalid script commandstats counter")
+			}
+			if _, duplicate := values[key]; duplicate {
+				return total, fmt.Errorf("duplicate script commandstats counter")
+			}
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil || n < 0 {
+				return total, fmt.Errorf("invalid script commandstats counter")
+			}
+			values[key] = n
+		}
+		if _, ok := values["calls"]; !ok {
+			return total, fmt.Errorf("missing script commandstats calls")
+		}
+		if _, ok := values["usec"]; !ok {
+			return total, fmt.Errorf("missing script commandstats usec")
+		}
+		found = true
+		total.Calls += values["calls"]
+		total.Microseconds += values["usec"]
+		total.Rejected += values["rejected_calls"]
+		total.Failed += values["failed_calls"]
+		if total.Calls < 0 || total.Microseconds < 0 || total.Rejected < 0 || total.Failed < 0 {
+			return compactionScriptStats{}, fmt.Errorf("script commandstats overflow")
+		}
+	}
+	if !found {
+		return total, fmt.Errorf("script commandstats unavailable")
+	}
+	return total, nil
+}
+
+func compactionReadScriptStats(ctx context.Context, client *goredis.Client) (compactionScriptStats, error) {
+	raw, err := client.Info(ctx, "commandstats").Result()
+	if err != nil {
+		return compactionScriptStats{}, fmt.Errorf("script commandstats request failed")
+	}
+	return compactionParseScriptStats(raw)
+}
+
+func compactionScriptStatsDelta(before, after compactionScriptStats) (compactionScriptStats, error) {
+	d := compactionScriptStats{Calls: after.Calls - before.Calls, Microseconds: after.Microseconds - before.Microseconds, Rejected: after.Rejected - before.Rejected, Failed: after.Failed - before.Failed}
+	if d.Calls != 1 || d.Microseconds < 0 || d.Rejected != 0 || d.Failed != 0 {
+		return d, fmt.Errorf("script commandstats contaminated, reset or failed")
+	}
+	return d, nil
+}
