+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+package redis
+
+import (
+	"context"
+
+	"github.com/apache/arrow-adbc/go/adbc"
+	goredis "github.com/redis/go-redis/v9"
+)
+
+// Execution and final index population have finished, so the private directory
+// and its first index-readiness probe are independent native reads. Select the
+// metadata primary explicitly, as searchDo does; do not rely on FT.INFO's key
+// inference in the Cluster API. Search keeps NoRetry for the whole pipeline.
+// A later readiness poll remains a fresh native FT.INFO, never this batch again.
+func (s *store) snapshotFirstIndexReadiness(ctx context.Context, meta *tableMeta) (int64, *goredis.Cmd, error) {
+	if err := ctx.Err(); err != nil {
+		return 0, nil, wrapRedis(err, "snapshot index readiness canceled")
+	}
+	node, err := s.search(ctx, meta.index())
+	if err != nil {
+		return 0, nil, err
+	}
+	client, ok := node.c.(interface{ Pipeline() goredis.Pipeliner })
+	if !ok {
+		return 0, nil, errorf(adbc.StatusIO, "snapshot readiness requires a pipeline-capable primary")
+	}
+	pipe := client.Pipeline()
+	count := pipe.ZCard(ctx, snapshotMembers(snapshotDataID(meta.prefix())))
+	info := goredis.NewCmd(ctx, "FT.INFO", meta.index())
+	if err := pipe.Process(ctx, onceCmd{info}); err != nil {
+		pipe.Discard()
+		return 0, nil, wrapRedis(err, "failed to queue snapshot index readiness")
+	}
+	_, execErr := pipe.Exec(ctx)
+	n, err := count.Result()
+	if err != nil {
+		return 0, nil, wrapRedis(err, "failed to validate snapshot directory")
+	}
+	// An unknown pipeline error is terminal even with populated replies or a
+	// native transient/permission error in FT.INFO. Only the same direct native
+	// response accounts for the pipeline's first-error return; no unwrapping.
+	if execErr != nil && !snapshotReadinessNativeErrorMatches(execErr, info.Err()) {
+		return 0, nil, wrapRedis(execErr, "failed to probe snapshot index readiness")
+	}
+	if err := ctx.Err(); err != nil {
+		return 0, nil, wrapRedis(err, "snapshot index readiness canceled")
+	}
+	return n, info, nil
+}
+
+func snapshotReadinessNativeErrorMatches(a, b error) bool {
+	left, leftOK := a.(interface {
+		error
+		RedisError()
+	})
+	right, rightOK := b.(interface {
+		error
+		RedisError()
+	})
+	return leftOK && rightOK && left.Error() == right.Error()
+}
+
+// This private-output polling path may retry only the two exact native Search
+// transient errors. A joined/wrapped error can carry reply loss as well.
+func snapshotReadinessTransient(err error) bool {
+	native, ok := err.(interface {
+		error
+		RedisError()
+	})
+	if !ok {
+		return false
+	}
+	return native.Error() == "Inconsistent index state" || native.Error() == "SEARCH_VALUE_BAD Inconsistent index state"
+}
