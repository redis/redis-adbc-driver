+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+package redis
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+
+	goredis "github.com/redis/go-redis/v9"
+)
+
+type snapshotPrivateReadinessTracker struct {
+	snapshotHook
+	batches atomic.Int64
+	invalid atomic.Bool
+}
+
+func (h *snapshotPrivateReadinessTracker) ProcessPipelineHook(next goredis.ProcessPipelineHook) goredis.ProcessPipelineHook {
+	return func(ctx context.Context, cmds []goredis.Cmder) error {
+		if scope := snapshotOf(ctx); scope != nil && scope.write && len(cmds) == 2 && cmds[0].Name() == "zcard" && cmds[1].Name() == "ft.info" {
+			h.batches.Add(1)
+			if once, ok := cmds[1].(interface{ NoRetry() bool }); !ok || !once.NoRetry() {
+				h.invalid.Store(true)
+			}
+		}
+		return next(ctx, cmds)
+	}
+}
+func TestSnapshotPublicationReadinessBatchesPrivateOutput(t *testing.T) {
+	h, raw, _ := newSnapshotHarnessMode(t, false, false)
+	h.exec("CREATE TABLE private_ready(id INTEGER,v BIGINT,payload VARCHAR)")
+	h.exec("INSERT INTO private_ready VALUES(1,9007199254740993,'one'),(2,NULL,'two'),(3,-9007199254740993,'three')")
+	s := snapshotTestStore(t, raw)
+	tracker := &snapshotPrivateReadinessTracker{}
+	s.client.AddHook(tracker)
+	snapshotExecuteTest(t, s, h.ctx, "UPDATE private_ready SET payload='after' WHERE __rowid=1")
+	if tracker.batches.Load() != 1 || tracker.invalid.Load() {
+		t.Fatal("first private readiness proof did not use one non-retry pipeline", tracker.batches.Load(), tracker.invalid.Load())
+	}
+	h.expectRows("SELECT id,v,payload FROM private_ready ORDER BY id", "1|9007199254740993|after", "2|NULL|two", "3|-9007199254740993|three")
+}
