@@ -0,0 +1,180 @@
+// Copyright (c) 2026 ADBC Drivers Contributors
+// Licensed under the Apache License, Version 2.0.
+package redis
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+
+	goredis "github.com/redis/go-redis/v9"
+)
+
+type snapshotIndexReadinessReplies struct {
+	batches, direct                int
+	wires                          [][]any
+	countErr, infoErr, pipelineErr error
+	count                          int64
+	reply                          any
+}
+
+func (h *snapshotIndexReadinessReplies) DialHook(next goredis.DialHook) goredis.DialHook { return next }
+func (h *snapshotIndexReadinessReplies) ProcessHook(_ goredis.ProcessHook) goredis.ProcessHook {
+	return func(_ context.Context, cmd goredis.Cmder) error {
+		h.direct++
+		err := fmt.Errorf("unexpected direct readiness command")
+		cmd.SetErr(err)
+		return err
+	}
+}
+func (h *snapshotIndexReadinessReplies) ProcessPipelineHook(_ goredis.ProcessPipelineHook) goredis.ProcessPipelineHook {
+	return func(_ context.Context, cmds []goredis.Cmder) error {
+		h.batches++
+		var first error
+		for _, cmd := range cmds {
+			h.wires = append(h.wires, append([]any(nil), cmd.Args()...))
+			switch c := cmd.(type) {
+			case *goredis.IntCmd:
+				c.SetVal(h.count)
+				c.SetErr(h.countErr)
+			case onceCmd:
+				if !c.NoRetry() {
+					return fmt.Errorf("readiness command can retry")
+				}
+				c.SetVal(h.reply)
+				c.SetErr(h.infoErr)
+			default:
+				return fmt.Errorf("unexpected readiness command %T", cmd)
+			}
+			if first == nil {
+				first = cmd.Err()
+			}
+		}
+		if h.pipelineErr != nil {
+			return h.pipelineErr
+		}
+		return first
+	}
+}
+func snapshotIndexReadinessFixture(t *testing.T) (*store, *tableMeta, *snapshotIndexReadinessReplies) {
+	t.Helper()
+	c := goredis.NewClient(&goredis.Options{Addr: "unused.invalid:1"})
+	t.Cleanup(func() { _ = c.Close() })
+	h := &snapshotIndexReadinessReplies{count: 7, reply: []any{"num_docs", int64(7)}}
+	c.AddHook(h)
+	id := strings.Repeat("a", 32)
+	meta := &tableMeta{KeyPrefix: snapshotRows(id, "public", strings.Repeat("b", 32)), IndexName: snapshotIndexPrefix(id) + "final"}
+	return &store{client: c}, meta, h
+}
+func TestSnapshotPublicationReadinessQueuesIndependentProofs(t *testing.T) {
+	s, m, h := snapshotIndexReadinessFixture(t)
+	n, info, err := s.snapshotFirstIndexReadiness(context.Background(), m)
+	if err != nil || n != 7 || info.Err() != nil || !reflect.DeepEqual(info.Val(), h.reply) {
+		t.Fatal(n, info, err)
+	}
+	want := [][]any{{"zcard", snapshotMembers(snapshotDataID(m.prefix()))}, {"FT.INFO", m.index()}}
+	if h.batches != 1 || h.direct != 0 || !reflect.DeepEqual(h.wires, want) {
+		t.Fatal("readiness commands changed/repeated", h.batches, h.direct, h.wires)
+	}
+}
+func TestSnapshotPublicationReadinessRejectsUnknownPipeline(t *testing.T) {
+	for _, kind := range []string{"populated_then_loss", "native_then_loss", "joined_native_loss", "wrapped_native", "count_precedence", "canceled"} {
+		t.Run(kind, func(t *testing.T) {
+			s, m, h := snapshotIndexReadinessFixture(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			want := "unexpected EOF"
+			switch kind {
+			case "populated_then_loss":
+				h.pipelineErr = io.ErrUnexpectedEOF
+			case "native_then_loss":
+				h.infoErr = readinessServerError("Inconsistent index state")
+				h.pipelineErr = io.ErrUnexpectedEOF
+			case "joined_native_loss":
+				h.infoErr = errors.Join(readinessServerError("Inconsistent index state"), io.ErrUnexpectedEOF)
+			case "wrapped_native":
+				h.infoErr = fmt.Errorf("wrapped: %w", readinessServerError("Inconsistent index state"))
+				want = "wrapped"
+			case "count_precedence":
+				h.countErr = errors.New("directory unavailable")
+				h.pipelineErr = io.ErrUnexpectedEOF
+				want = "directory unavailable"
+			case "canceled":
+				cancel()
+				want = "canceled"
+			}
+			_, info, err := s.snapshotFirstIndexReadiness(ctx, m)
+			if err == nil || info != nil || !strings.Contains(err.Error(), want) {
+				t.Fatal("unknown readiness accepted/reclassified", info, err)
+			}
+			wantBatches := 1
+			if kind == "canceled" {
+				wantBatches = 0
+			}
+			if h.batches != wantBatches || h.direct != 0 {
+				t.Fatal("unknown readiness was replayed", h.batches, h.direct)
+			}
+		})
+	}
+}
+func TestSnapshotPublicationReadinessPreservesNativeRefusal(t *testing.T) {
+	for _, message := range []string{"Inconsistent index state", "SEARCH_VALUE_BAD Inconsistent index state", "NOPERM no FT.INFO permission", "Unknown index name"} {
+		t.Run(message, func(t *testing.T) {
+			s, m, h := snapshotIndexReadinessFixture(t)
+			h.infoErr = readinessServerError(message)
+			n, info, err := s.snapshotFirstIndexReadiness(context.Background(), m)
+			if err != nil || n != 7 || info.Err() != h.infoErr || h.batches != 1 || h.direct != 0 {
+				t.Fatal("native outcome changed/replayed", n, info, err)
+			}
+		})
+	}
+}
+func TestSnapshotPublicationReadinessRetriesDirectNativeOnly(t *testing.T) {
+	for _, message := range []string{"Inconsistent index state", "SEARCH_VALUE_BAD Inconsistent index state"} {
+		native := readinessServerError(message)
+		if !snapshotReadinessTransient(native) {
+			t.Fatal("native transient lost", message)
+		}
+		for _, err := range []error{errors.New(message), fmt.Errorf("wrapped: %w", native), errors.Join(native, io.ErrUnexpectedEOF), readinessServerError(message + ": different failure")} {
+			if snapshotReadinessTransient(err) {
+				t.Fatal("unknown/altered error classified transient", err)
+			}
+		}
+	}
+}
+
+// Normal go-redis queues currently return nil; a pipeline implementation may
+// return a local error without populating the queued command. Never ignore it.
+type snapshotReadinessQueueFailureClient struct {
+	goredis.UniversalClient
+	pipe *snapshotReadinessQueueFailurePipeline
+}
+
+func (c *snapshotReadinessQueueFailureClient) Pipeline() goredis.Pipeliner { return c.pipe }
+
+type snapshotReadinessQueueFailurePipeline struct {
+	goredis.Pipeliner
+	execs, discards int
+}
+
+func (*snapshotReadinessQueueFailurePipeline) Process(context.Context, goredis.Cmder) error {
+	return io.ErrUnexpectedEOF
+}
+func (p *snapshotReadinessQueueFailurePipeline) Exec(ctx context.Context) ([]goredis.Cmder, error) {
+	p.execs++
+	return p.Pipeliner.Exec(ctx)
+}
+func (p *snapshotReadinessQueueFailurePipeline) Discard() { p.discards++; p.Pipeliner.Discard() }
+func TestSnapshotPublicationReadinessQueueFailureStopsBeforeExec(t *testing.T) {
+	s, m, _ := snapshotIndexReadinessFixture(t)
+	pipe := &snapshotReadinessQueueFailurePipeline{Pipeliner: s.client.Pipeline()}
+	s.client = &snapshotReadinessQueueFailureClient{UniversalClient: s.client, pipe: pipe}
+	_, info, err := s.snapshotFirstIndexReadiness(context.Background(), m)
+	if err == nil || info != nil || !strings.Contains(err.Error(), "unexpected EOF") || pipe.execs != 0 || pipe.discards != 1 {
+		t.Fatal("local queue failure was executed or forgotten", info, err, "exec", pipe.execs, "discard", pipe.discards)
+	}
+}
