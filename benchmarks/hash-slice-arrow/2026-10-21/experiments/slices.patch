+package redis
+
+import (
+	"context"
+	"errors"
+	goredis "github.com/redis/go-redis/v9"
+)
+
+func (s *store) fetchRowSlices(ctx context.Context, keys []string, fields []string, chunk int) ([][]any, error) {
+	fields = append([]string{rowIDField}, fields...)
+	out := make([][]any, len(keys))
+	for start := 0; start < len(keys); start += chunk {
+		if err := cancelled(ctx); err != nil {
+			return nil, err
+		}
+		end := min(start+chunk, len(keys))
+		pipe := s.client.Pipeline()
+		cmds := make([]*goredis.SliceCmd, 0, end-start)
+		for _, k := range keys[start:end] {
+			if k == "" {
+				cmds = append(cmds, nil) // already found deleted by the cursor
+				continue
+			}
+			cmds = append(cmds, pipe.HMGet(ctx, k, fields...))
+		}
+		if _, err := pipe.Exec(ctx); err != nil && !errors.Is(err, goredis.Nil) {
+			return nil, wrapRedis(err, "failed to read rows")
+		}
+		for i, cmd := range cmds {
+			if cmd == nil {
+				continue
+			}
+			vals, err := cmd.Result()
+			if err != nil {
+				return nil, wrapRedis(err, "failed to read rows")
+			}
+			if vals[0] == nil {
+				continue // row vanished
+			}
+			out[start+i] = vals
+		}
+	}
+	return out, nil
+}
